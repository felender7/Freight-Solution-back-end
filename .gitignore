# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files from your text editor, you
# might want to add them to a global .gitignore instead.

# Bundler
.bundle/
vendor/bundle

# By default, files installed via gem packages are not tracked in git.
# If you want to track them, uncomment the following line.
# /vendor/gems

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and local database files.
/log/*
/tmp/*
/storage/*
!/storage/file/.keep
!/storage/.keep

# Ignore local environment files.
.env
.env.local
.env.*.local

# Ignore master key for decrypting credentials.
config/credentials.yml.enc

# Ignore Node_modules
node_modules/

# Ignore pidfiles
/pids
/pid

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore Rails cache files
cache/
tmp/cache/

# Ignore server logs
server.log

# Ignore coverage reports
coverage/
.coverage

# Ignore if using Kamal for deployment
/.kamal

# Ignore key files for decrypting credentials and more.
/config/credentials/
config/master.key

