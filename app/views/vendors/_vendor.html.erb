<div id="<%= dom_id vendor %>">
  <div>
    <strong>Name:</strong>
    <%= vendor.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= vendor.email %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= vendor.phone %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= vendor.address %>
  </div>

  <div>
    <strong>Bank reference:</strong>
    <%= vendor.bank_reference %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= vendor.status %>
  </div>

</div>
