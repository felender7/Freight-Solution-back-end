<header class="main-header"><h1 class="page-title">New User</h1></header>
<div class="main-body">
  <a href="<%= admin_users_path %>" class="back-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>Back</a>
  <div class="card" style="margin-top: 24px;"><div class="card-body">
    <%= form_with model: [:admin, @user], local: true do |f| %>
      <div class="form-row"><div class="form-group-full"><%= f.label :first_name %><%= f.text_field :first_name, required: true %></div><div class="form-group-full"><%= f.label :last_name %><%= f.text_field :last_name, required: true %></div></div>
      <div class="form-row"><div class="form-group-full"><%= f.label :email %><%= f.email_field :email, required: true %></div><div class="form-group-full"><%= f.label :role %><%= f.select :role, ['user', 'admin'], selected: 'user' %></div></div>
      <div class="form-row"><div class="form-group-full"><%= f.label :password %><%= f.password_field :password %></div><div class="form-group-full"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation %></div></div>
      <div style="margin-top: 24px;"><%= f.submit 'Create', class: 'btn btn-blue' %></div>
    <% end %>
  </div></div>
</div>