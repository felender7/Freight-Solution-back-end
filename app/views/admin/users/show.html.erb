<div class="p-8 animate-fade-in space-y-8">
  
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
    <!-- Header with Background Graphic -->
    <div class="relative px-8 py-10 bg-slate-800 border-b border-slate-700 overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-10 text-indigo-500">
        <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-indigo-500/20">
            <%= @user.first_name[0] %>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-3xl font-black text-slate-100 tracking-tight uppercase"><%= @user.first_name %> <%= @user.last_name %></h1>
              <span class="px-3 py-1 bg-indigo-500/20 text-indigo-400 text-[10px] font-black uppercase tracking-widest rounded-full border border-indigo-500/30">
                <%= @user.role %>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-slate-400 text-sm">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <%= @user.email %>
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Joined <%= @user.created_at.strftime('%B %Y') %>
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="<%= edit_admin_user_path(@user) %>" 
             class="px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg shadow-blue-500/25 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Update Account
          </a>
          <a href="<%= admin_users_path %>" 
             class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all flex items-center gap-2">
            Back to Directory
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x border-slate-700">
      <!-- Status Quick View -->
      <div class="p-8 bg-slate-800/30">
        <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-6">Access Control Status</h3>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/50 border border-slate-700/50 shadow-inner">
            <span class="text-slate-400 text-xs font-bold uppercase">Account Status</span>
            <span class="px-3 py-1 text-[10px] font-black uppercase rounded-lg border
              <%= @user.must_update_password ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-green-500/10 text-green-400 border-green-500/20' %>">
              <%= @user.must_update_password ? 'Action Required' : 'Active' %>
            </span>
          </div>
          
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/50 border border-slate-700/50 shadow-inner">
            <span class="text-slate-400 text-xs font-bold uppercase">System Role</span>
            <span class="text-slate-200 text-sm font-black uppercase tracking-tighter"><%= @user.role %></span>
          </div>

          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/50 border border-slate-700/50 shadow-inner">
            <span class="text-slate-400 text-xs font-bold uppercase">Force Password</span>
            <span class="text-slate-200 text-sm font-black uppercase tracking-tighter"><%= @user.must_update_password ? 'Yes' : 'No' %></span>
          </div>
        </div>
      </div>

      <!-- Account Summary -->
      <div class="p-8 lg:col-span-2">
        <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-6">Account Overview</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 shadow-inner">
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-2">Total System Actions</label>
            <p class="text-4xl font-black text-slate-100"><%= @user.activity_logs.count %></p>
            <p class="mt-2 text-[10px] text-slate-500 font-bold uppercase">Recorded in global audit log</p>
          </div>
          
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 shadow-inner">
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-2">Last System Activity</label>
            <p class="text-xl font-black text-indigo-400">
              <%= @activity_logs.first&.created_at&.strftime('%d %b %Y, %H:%M') || 'No activity yet' %>
            </p>
            <p class="mt-2 text-[10px] text-slate-500 font-bold uppercase">Based on recent event logs</p>
          </div>

          <div class="md:col-span-2 grid grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-slate-700/50">
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">First Name</label>
              <p class="text-slate-200 font-bold text-sm"><%= @user.first_name %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">Last Name</label>
              <p class="text-slate-200 font-bold text-sm"><%= @user.last_name %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">Created At</label>
              <p class="text-slate-200 text-sm font-bold"><%= @user.created_at.strftime('%Y-%m-%d') %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">User ID</label>
              <p class="text-slate-500 font-mono text-[10px]">#USR-<%= @user.id %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- System Audit Log Section -->
  <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 overflow-hidden shadow-xl">
    <div class="px-8 py-6 border-b border-slate-700 flex justify-between items-center bg-slate-900/30">
      <div>
        <h3 class="text-lg font-black text-slate-100 flex items-center gap-2 uppercase tracking-widest">
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          System Audit Log
        </h3>
        <p class="text-slate-500 text-[10px] font-bold uppercase mt-1">Showing latest 50 security and operational events</p>
      </div>
      <span class="px-3 py-1 bg-slate-900 border border-slate-700 rounded-lg text-[10px] font-black text-slate-400 uppercase">
        Real-time Feed
      </span>
    </div>
    
    <div class="p-0">
      <% if @activity_logs.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="text-left text-slate-500 text-[10px] font-black uppercase tracking-widest border-b border-slate-700/30">
                <th class="py-4 px-8">Event Action</th>
                <th class="py-4 px-4">Entity Context</th>
                <th class="py-4 px-4">Timestamp</th>
                <th class="py-4 px-8 text-right">Technical Metadata</th>
              </tr>
            </thead>
            <tbody>
              <% @activity_logs.each do |log| %>
                <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors group">
                  <td class="py-4 px-8">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-lg bg-slate-900 flex items-center justify-center border border-slate-700">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                      </div>
                      <span class="text-slate-200 text-xs font-black uppercase tracking-tighter"><%= log.action %></span>
                    </div>
                  </td>
                  <td class="py-4 px-4">
                    <p class="text-slate-300 text-xs font-bold"><%= log.entity_type %></p>
                    <p class="text-[10px] text-slate-500 font-mono">ID: #<%= log.entity_id %></p>
                  </td>
                  <td class="py-4 px-4">
                    <p class="text-slate-400 text-xs font-medium"><%= log.created_at.strftime('%d %b, %H:%M:%S') %></p>
                  </td>
                  <td class="py-4 px-8 text-right">
                    <div class="flex flex-wrap gap-1 justify-end">
                      <% if log.metadata.is_a?(Hash) %>
                        <% log.metadata.first(2).each do |k, v| %>
                          <span class="px-1.5 py-0.5 bg-slate-900 rounded border border-slate-800 text-[8px] font-mono text-slate-500"><%= k %>: <%= v %></span>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="py-16 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-700">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <p class="text-slate-500 text-sm italic font-medium">No system activity has been recorded for this user.</p>
        </div>
      <% end %>
    </div>
  </div>

</div>
