<div class="p-8">

  <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-100">User Details</h1>
        <p class="text-slate-400 text-sm mt-1">
          Account information and access permissions
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="<%= admin_users_path %>" 
           class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back
        </a>

        <a href="<%= edit_admin_user_path(@user) %>" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-all">
          Edit
        </a>
      </div>
    </div>

    <!-- Content -->
    <div class="p-8">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Name -->
        <div>
          <p class="text-slate-500 text-sm mb-1">Name</p>
          <p class="text-slate-100 text-lg font-medium">
            <%= @user.first_name %> <%= @user.last_name %>
          </p>
        </div>

        <!-- Email -->
        <div>
          <p class="text-slate-500 text-sm mb-1">Email</p>
          <p class="text-slate-100 text-lg">
            <%= @user.email %>
          </p>
        </div>

        <!-- Role -->
        <div>
          <p class="text-slate-500 text-sm mb-1">Role</p>
          <span class="inline-flex px-3 py-1 rounded-full text-xs font-medium border
            <%= @user.role == 'admin' ? 
              'bg-blue-500/10 text-blue-400 border-blue-500/20' : 
              'bg-yellow-500/10 text-yellow-400 border-yellow-500/20' %>">
            <%= @user.role %>
          </span>
        </div>

        <!-- Status -->
        <div>
          <p class="text-slate-500 text-sm mb-1">Status</p>
          <span class="inline-flex px-3 py-1 rounded-full text-xs font-medium border
            <%= @user.must_update_password ? 
              'bg-red-500/10 text-red-400 border-red-500/20' : 
              'bg-green-500/10 text-green-400 border-green-500/20' %>">
            <%= @user.must_update_password ? 'Password required' : 'Active' %>
          </span>
        </div>

      </div>

    </div>

  </div>
</div>