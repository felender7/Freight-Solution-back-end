<header class="main-header">
  <h1 class="page-title">Dashboard</h1>
  <div class="header-actions">
    <button class="notification-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      <span class="notification-badge"></span>
    </button>
  </div>
</header>

<div class="main-body">
  <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
  
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon blue">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
      </div>
      <div class="stat-value"><%= @employees_count %></div>
      <div class="stat-label">Total Employees</div>
    </div>
    
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon green">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
      </div>
      <div class="stat-value"><%= @vendors_count %></div>
      <div class="stat-label">Active Vendors</div>
    </div>
    
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon yellow">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        </div>
      </div>
      <div class="stat-value"><%= @shipments_count %></div>
      <div class="stat-label">Total Shipments</div>
    </div>
    
    <div class="stat-card">
      <div class="stat-header">
        <div class="stat-icon purple">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <div class="stat-value">R<%= number_with_delimiter(@total_revenue.round(2)) %></div>
      <div class="stat-label">Total Revenue</div>
    </div>
  </div>

  <div class="two-column">
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Recent Shipments</h2>
        <a href="<%= admin_shipments_path %>" class="btn btn-sm btn-secondary">View All</a>
      </div>
      <div class="card-body">
        <% if @recent_shipments.any? %>
          <table>
            <thead>
              <tr>
                <th>Container</th>
                <th>Destination</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_shipments.each do |shipment| %>
                <tr>
                  <td><%= shipment.container_number %></td>
                  <td><%= shipment.destination %></td>
                  <td>
                    <span class="badge <%= shipment.status == 'delivered' ? 'badge-success' : shipment.status == 'in_transit' ? 'badge-warning' : 'badge-info' %>">
                      <%= shipment.status || 'pending' %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
            <p>No shipments found</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Recent Invoices</h2>
        <a href="<%= admin_invoices_path %>" class="btn btn-sm btn-secondary">View All</a>
      </div>
      <div class="card-body">
        <% if @recent_invoices.any? %>
          <table>
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_invoices.each do |invoice| %>
                <tr>
                  <td><%= invoice.invoice_number %></td>
                  <td>R<%= number_with_delimiter(invoice.amount.round(2)) %></td>
                  <td>
                    <span class="badge <%= invoice.status == 'paid' ? 'badge-success' : invoice.status == 'pending' ? 'badge-warning' : 'badge-error' %>">
                      <%= invoice.status || 'pending' %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <p>No invoices found</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>