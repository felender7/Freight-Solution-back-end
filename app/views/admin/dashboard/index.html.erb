<div class="animate-fade-in p-8">

  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700">
      <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
        <span>Dashboard</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-slate-300">Overview</span>
      </div>
      <h1 class="text-3xl font-bold text-slate-100">Welcome back, <%= current_user ? current_user.first_name : 'Admin' %>!</h1>
      <p class="text-slate-400 mt-1">Here's what's happening with your business today.</p>
    </div>

    <!-- Notice -->
    <% if notice %>
      <div class="px-8 pt-6">
        <div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg animate-fade-in">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <!-- Stats Cards -->
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-8 w-full">
        <!-- Employees Card -->
        <div class="glass-card rounded-2xl p-6 glow-blue hover:scale-[1.02] transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/30">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            </div>
            <span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs font-medium rounded-full">+12%</span>
          </div>
          <div class="text-4xl font-bold text-slate-100 mb-1"><%= @employees_count %></div>
          <div class="text-slate-400 text-sm">Total Employees</div>
          <div class="mt-4 h-1 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-blue-500 to-blue-600 rounded-full" style="width: 75%"></div>
          </div>
        </div>
        
        <!-- Vendors Card -->
        <div class="glass-card rounded-2xl p-6 glow-green hover:scale-[1.02] transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg shadow-green-500/30">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs font-medium rounded-full">+8%</span>
          </div>
          <div class="text-4xl font-bold text-slate-100 mb-1"><%= @vendors_count %></div>
          <div class="text-slate-400 text-sm">Active Vendors</div>
          <div class="mt-4 h-1 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-green-500 to-green-600 rounded-full" style="width: 60%"></div>
          </div>
        </div>

        <!-- Clients Card -->
        <div class="glass-card rounded-2xl p-6 glow-indigo hover:scale-[1.02] transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/30">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
            <span class="px-2 py-1 bg-indigo-500/20 text-indigo-400 text-xs font-medium rounded-full">New</span>
          </div>
          <div class="text-4xl font-bold text-slate-100 mb-1"><%= @clients_count %></div>
          <div class="text-slate-400 text-sm">Total Clients</div>
          <div class="mt-4 h-1 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full" style="width: 40%"></div>
          </div>
        </div>
        
        <!-- Shipments Card -->
        <div class="glass-card rounded-2xl p-6 glow-yellow hover:scale-[1.02] transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center shadow-lg shadow-yellow-500/30">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
              </svg>
            </div>
            <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 text-xs font-medium rounded-full">+24%</span>
          </div>
          <div class="text-4xl font-bold text-slate-100 mb-1"><%= @shipments_count %></div>
          <div class="text-slate-400 text-sm">Total Shipments</div>
          <div class="mt-4 h-1 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full" style="width: 85%"></div>
          </div>
        </div>
        
        <!-- Revenue Card -->
        <div class="glass-card rounded-2xl p-6 glow-purple hover:scale-[1.02] transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center shadow-lg shadow-purple-500/30">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <span class="px-2 py-1 bg-purple-500/20 text-purple-400 text-xs font-medium rounded-full">+18%</span>
          </div>
          <div class="text-3xl font-bold text-slate-100 mb-1">R<%= number_with_delimiter(@total_revenue.round(2)) %></div>
          <div class="text-slate-400 text-sm">Total Revenue</div>
          <div class="mt-4 h-1 bg-slate-700 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-purple-500 to-purple-600 rounded-full" style="width: 90%"></div>
          </div>
        </div>
      </div>

      <!-- Charts & Tables Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full">
        <!-- Recent Shipments -->
        <div class="glass-card rounded-2xl overflow-hidden border border-slate-700/50">
          <div class="px-6 py-4 border-b border-slate-700/30 flex justify-between items-center">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-yellow-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                </svg>
              </div>
              <div>
                <h2 class="text-slate-100 font-semibold">Recent Shipments</h2>
                <p class="text-slate-500 text-xs">Latest container movements</p>
              </div>
            </div>
            <a href="<%= admin_shipments_path %>" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white text-sm font-medium rounded-lg transition-all shadow-lg shadow-blue-500/25">View All</a>
          </div>
          <div class="p-4">
            <% if @recent_shipments.any? %>
              <div class="space-y-3">
                <% @recent_shipments.each do |shipment| %>
                  <div class="flex items-center justify-between p-3 bg-slate-800/50 rounded-xl hover:bg-slate-700/50 transition-colors">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-lg bg-slate-700 flex items-center justify-center">
                        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                      </div>
                      <div>
                        <p class="text-slate-200 font-medium"><%= shipment.container_number || 'N/A' %></p>
                        <p class="text-slate-500 text-sm"><%= shipment.destination || 'No destination' %></p>
                      </div>
                    </div>
                    <span class="px-3 py-1.5 rounded-full text-xs font-medium 
                      <%= case shipment.status
                        when 'delivered' then 'bg-green-500/20 text-green-400 border border-green-500/30'
                        when 'in_transit' then 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'
                        else 'bg-blue-500/20 text-blue-400 border border-blue-500/30'
                      end %>">
                      <%= shipment.status || 'pending' %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-8">
                <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-slate-800 flex items-center justify-center">
                  <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                  </svg>
                </div>
                <p class="text-slate-500">No shipments found</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Recent Invoices -->
        <div class="glass-card rounded-2xl overflow-hidden border border-slate-700/50">
          <div class="px-6 py-4 border-b border-slate-700/30 flex justify-between items-center">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-slate-100 font-semibold">Recent Invoices</h2>
                <p class="text-slate-500 text-xs">Latest billing activity</p>
              </div>
            </div>
            <a href="<%= admin_invoices_path %>" class="px-4 py-2 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white text-sm font-medium rounded-lg transition-all shadow-lg shadow-blue-500/25">View All</a>
          </div>
          <div class="p-4">
            <% if @recent_invoices.any? %>
              <div class="space-y-3">
                <% @recent_invoices.each do |invoice| %>
                  <div class="flex items-center justify-between p-3 bg-slate-800/50 rounded-xl hover:bg-slate-700/50 transition-colors">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                      </div>
                      <div>
                        <p class="text-slate-200 font-medium"><%= invoice.invoice_number || 'N/A' %></p>
                        <p class="text-slate-500 text-sm">R<%= number_with_delimiter(invoice.amount.round(2)) %></p>
                      </div>
                    </div>
                    <span class="px-3 py-1.5 rounded-full text-xs font-medium 
                      <%= case invoice.status
                        when 'paid' then 'bg-green-500/20 text-green-400 border border-green-500/30'
                        when 'pending' then 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'
                        else 'bg-red-500/20 text-red-400 border border-red-500/30'
                      end %>">
                      <%= invoice.status || 'pending' %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-8">
                <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-slate-800 flex items-center justify-center">
                  <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <p class="text-slate-500">No invoices found</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>