<div class="animate-fade-in p-8">

  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      
      <!-- Left -->
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>HRM</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span>Tasks</span>
        </div>

        <h1 class="text-3xl font-bold text-slate-100   tracking-tight">Task Registry</h1>
        <p class="text-slate-400 mt-1">
          Monitor operational assignments, deadlines, and completion statuses
        </p>
      </div>

      <!-- Right -->
      <a href="<%= new_admin_hrm_task_path %>" 
         class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        New Task
      </a>
    </div>

    <!-- Notice -->
    <% if notice %>
      <div class="px-8 pt-6">
        <div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg animate-fade-in flex items-center gap-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <%= notice %>
        </div>
      </div>
    <% end %>

    <!-- Table -->
    <div class="p-6">
      <% if @tasks.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            
            <thead>
              <tr class="border-b border-slate-700/30">
                <th class="text-left text-slate-500 text-xs font-semibold   tracking-wider py-4 px-4">Task Details</th>
                <th class="text-left text-slate-500 text-xs font-semibold   tracking-wider py-4 px-4">Assigned To</th>
                <th class="text-left text-slate-500 text-xs font-semibold   tracking-wider py-4 px-4">Priority</th>
                <th class="text-left text-slate-500 text-xs font-semibold   tracking-wider py-4 px-4">Due Date</th>
                <th class="text-left text-slate-500 text-xs font-semibold   tracking-wider py-4 px-4">Status</th>
                <th class="text-right text-slate-500 text-xs font-semibold   tracking-wider py-4 px-4">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @tasks.each do |task| %>
                <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors group">
                  
                  <!-- Task -->
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-indigo-400 font-bold text-xs group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-inner">
                        <%= task.title[0] %>
                      </div>
                      <div>
                        <p class="text-slate-200 font-medium"><%= task.title %></p>
                        <p class="text-slate-500 text-[10px] truncate max-w-[200px]"><%= task.description %></p>
                      </div>
                    </div>
                  </td>

                  <!-- Assignee -->
                  <td class="py-4 px-4">
                    <p class="text-slate-300 text-xs font-bold  "><%= task.employee ? "#{task.employee.first_name} #{task.employee.last_name}" : '-' %></p>
                  </td>

                  <!-- Priority -->
                  <td class="py-4 px-4">
                    <span class="px-3 py-1.5 rounded-full text-[10px] font-black border
                      <%= case task.priority 
                        when 'high' then 'bg-red-500/10 text-red-400 border-red-500/20' 
                        when 'medium' then 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20' 
                        else 'bg-slate-800 text-slate-500 border-slate-700' 
                      end %>">
                      <%= task.priority&.upcase %>
                    </span>
                  </td>

                  <!-- Due Date -->
                  <td class="py-4 px-4">
                    <p class="text-slate-400 text-xs font-medium"><%= task.due_date ? task.due_date.strftime('%d %b %Y') : '-' %></p>
                  </td>

                  <!-- Status -->
                  <td class="py-4 px-4">
                    <span class="px-3 py-1.5 rounded-full text-[10px] font-black border
                      <%= case task.status 
                        when 'done' then 'bg-green-500/10 text-green-400 border-green-500/20' 
                        when 'in_progress' then 'bg-blue-500/10 text-blue-400 border-blue-500/20' 
                        else 'bg-slate-800 text-slate-500 border-slate-700' 
                      end %>">
                      <%= task.status&.titleize %>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="py-4 px-4">
                    <div class="flex gap-2 justify-end opacity-0 group-hover:opacity-100 transition-opacity">
                      
                      <a href="<%= edit_admin_hrm_task_path(task) %>" 
                         class="p-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg transition-colors" title="Edit Task">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      </a>

                      <%= button_to admin_hrm_task_path(task),
                        method: :delete,
                        form: { class: 'inline-block', data: { turbo: false, confirm: "Are you sure you want to delete this task? This action cannot be undone." } },
                        class: 'p-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors cursor-pointer',
                        title: 'Delete' do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>

                    </div>
                  </td>

                </tr>
              <% end %>
            </tbody>

          </table>
        </div>

      <% else %>

        <!-- Empty State -->
        <div class="text-center py-16">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center text-slate-500">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>

          <h3 class="text-xl font-semibold text-slate-200 mb-2">No active assignments</h3>
          <p class="text-slate-500 mb-6">
            Assign the first operational or administrative task
          </p>

          <a href="<%= new_admin_hrm_task_path %>" 
             class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Assign First Task
          </a>
        </div>

      <% end %>
    </div>

  </div>
</div>
