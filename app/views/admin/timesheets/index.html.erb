<div class="animate-fade-in p-8">
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">
    <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span>Timesheets</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-100">Timesheets</h1>
        <p class="text-slate-400 mt-1">Track employee work hours</p>
      </div>
      <a href="<%= new_admin_timesheet_path %>" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-xl font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
        Add Timesheet
      </a>
    </div>
    <% if notice %><div class="px-8 pt-6"><div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg"><%= notice %></div></div><% end %>
    <div class="p-6">
      <% if @timesheets.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-slate-700/30">
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Employee</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Date</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Hours</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Status</th>
                <th class="text-right text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @timesheets.each do |ts| %>
                <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 group">
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm">
                        <%= ts.employee.first_name[0] %><%= ts.employee.last_name[0] %>
                      </div>
                      <p class="text-slate-200 font-medium"><%= ts.employee.first_name %> <%= ts.employee.last_name %></p>
                    </div>
                  </td>
                  <td class="py-4 px-4"><span class="text-slate-400 text-sm"><%= ts.date ? ts.date.strftime('%b %d, %Y') : '-' %></span></td>
                  <td class="py-4 px-4"><span class="text-slate-100 font-semibold"><%= ts.hours_worked || 0 %>h</span></td>
                  <td class="py-4 px-4">
                    <span class="px-3 py-1.5 rounded-full text-xs font-medium 
                      <%= case ts.status when 'approved' then 'bg-green-500/20 text-green-400' when 'rejected' then 'bg-red-500/20 text-red-400' else 'bg-yellow-500/20 text-yellow-400' end %>">
                      <%= ts.status || 'pending' %>
                    </span>
                  </td>
                  <td class="py-4 px-4">
                    <div class="flex gap-2 justify-end opacity-0 group-hover:opacity-100">
                      <a href="<%= edit_admin_timesheet_path(ts) %>" class="p-2 bg-slate-700 text-slate-300 rounded-lg"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                      <%= button_to admin_timesheet_path(ts),
                        method: :delete,
                        form: { class: 'inline-block', data: { turbo: false, confirm: "Are you sure you want to delete this timesheet? This action cannot be undone." } },
                        class: 'p-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors cursor-pointer',
                        title: 'Delete' do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-16">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
            <svg class="w-10 h-10 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-200 mb-2">No timesheets yet</h3>
          <a href="<%= new_admin_timesheet_path %>" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-xl font-medium">Add First Timesheet</a>
        </div>
      <% end %>
    </div>
  </div>
</div>