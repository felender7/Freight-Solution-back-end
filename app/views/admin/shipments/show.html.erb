<header class="main-header"><h1 class="page-title">Shipment Details</h1><div class="header-actions"><a href="<%= edit_admin_shipment_path(@shipment) %>" class="btn btn-blue">Edit</a></div></header>
<div class="main-body">
  <a href="<%= admin_shipments_path %>" class="back-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>Back</a>
  <div class="card" style="margin-top: 24px;"><div class="card-body"><div class="two-column">
    <div><p style="color:#64748b;font-size:14px;margin-bottom:4px;">Container</p><p style="color:#f8fafc;font-size:18px;"><%= @shipment.container_number %></p></div>
    <div><p style="color:#64748b;font-size:14px;margin-bottom:4px;">Booking Ref</p><p style="color:#f8fafc;font-size:18px;"><%= @shipment.booking_reference || '-' %></p></div>
    <div><p style="color:#64748b;font-size:14px;margin-bottom:4px;">Origin</p><p style="color:#f8fafc;font-size:18px;"><%= @shipment.origin %></p></div>
    <div><p style="color:#64748b;font-size:14px;margin-bottom:4px;">Destination</p><p style="color:#f8fafc;font-size:18px;"><%= @shipment.destination %></p></div>
    <div><p style="color:#64748b;font-size:14px;margin-bottom:4px;">Status</p><span class="badge <%= @shipment.status=='delivered'?'badge-success':@shipment.status=='in_transit'?'badge-warning':'badge-info' %>"><%= @shipment.status||'pending' %></span></div>
    <div><p style="color:#64748b;font-size:14px;margin-bottom:4px;">Ship Date</p><p style="color:#f8fafc;font-size:18px;"><%= @shipment.ship_date ? @shipment.ship_date.strftime('%Y-%m-%d') : '-' %></p></div>
  </div></div></div>
</div>