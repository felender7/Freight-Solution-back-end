<div class="p-8">

  <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden w-full">
    
    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-100">New Shipment</h1>
        <p class="text-slate-400 text-sm mt-1">
          Create a new shipment and track logistics details
        </p>
      </div>

      <a href="<%= admin_shipments_path %>" 
         class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
      </a>
    </div>

    <!-- Form -->
    <div class="p-8">
      <%= form_with model: [:admin, @shipment], local: true do |f| %>

        <% if @shipment.errors.any? %>
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
            <ul class="list-disc list-inside">
              <% @shipment.errors.full_messages.each do |m| %>
                <li><%= m %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Container Info -->
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Container Number</label>
            <%= f.text_field :container_number, required: true,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>

          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Booking Reference</label>
            <%= f.text_field :booking_reference,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>
        </div>

        <!-- Route -->
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Origin</label>
            <%= f.text_field :origin, required: true,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>

          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Destination</label>
            <%= f.text_field :destination, required: true,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>
        </div>

        <!-- Status & Ship Date -->
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
            <%= f.select :status, ['pending', 'in_transit', 'delivered'], { selected: 'pending' },
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>

          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Ship Date</label>
            <%= f.date_field :ship_date,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>
        </div>

        <!-- Arrival -->
        <div class="mb-8">
          <label class="block text-slate-300 text-sm font-medium mb-2.5">Estimated Arrival</label>
          <%= f.date_field :estimated_arrival,
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4">
          <%= f.submit 'Create Shipment',
            class: "px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-all cursor-pointer" %>

          <a href="<%= admin_shipments_path %>" 
             class="px-6 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-medium transition-all">
            Cancel
          </a>
        </div>

      <% end %>
    </div>

  </div>
</div>