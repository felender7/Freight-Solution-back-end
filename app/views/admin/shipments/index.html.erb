<header class="main-header">
  <h1 class="page-title">Shipments</h1>
  <div class="header-actions">
    <a href="<%= new_admin_shipment_path %>" class="btn btn-blue">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      Add Shipment
    </a>
  </div>
</header>

<div class="main-body">
  <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
  <div class="card">
    <div class="card-body">
      <% if @shipments.any? %>
        <table>
          <thead><tr><th>Container #</th><th>Booking Ref</th><th>Origin</th><th>Destination</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% @shipments.each do |s| %>
              <tr>
                <td><strong><%= s.container_number %></strong></td>
                <td><%= s.booking_reference || '-' %></td>
                <td><%= s.origin %></td>
                <td><%= s.destination %></td>
                <td><span class="badge <%= s.status == 'delivered' ? 'badge-success' : s.status == 'in_transit' ? 'badge-warning' : 'badge-info' %>"><%= s.status || 'pending' %></span></td>
                <td><div class="actions"><a href="<%= admin_shipment_path(s) %>" class="btn btn-sm btn-secondary">View</a><a href="<%= edit_admin_shipment_path(s) %>" class="btn btn-sm btn-secondary">Edit</a><%= button_to 'Delete', admin_shipment_path(s), method: :delete, data: { confirm: 'Sure?' }, class: 'btn btn-sm btn-danger' %></div></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %><div class="empty-state"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg><p>No shipments found</p></div><% end %>
    </div>
  </div>
</div>