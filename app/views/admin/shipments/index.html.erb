<div class="animate-fade-in p-8">

  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      
      <!-- Left -->
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span>Shipments</span>
        </div>

        <h1 class="text-3xl font-bold text-slate-100">Shipments</h1>
        <p class="text-slate-400 mt-1">
          Track and manage all container shipments
        </p>
      </div>

      <!-- Right -->
      <a href="<%= new_admin_shipment_path %>" 
         class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-yellow-500 to-orange-600 hover:from-yellow-600 hover:to-orange-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-yellow-500/25 hover:shadow-yellow-500/40">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Add Shipment
      </a>
    </div>

    <!-- Notice -->
    <% if notice %>
      <div class="px-8 pt-6">
        <div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg animate-fade-in">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <!-- Table -->
    <div class="p-6">
      <% if @shipments.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            
            <thead>
              <tr class="border-b border-slate-700/30">
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Container</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Booking Ref</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Route</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Status</th>
                <th class="text-right text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @shipments.each do |shipment| %>
                <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors group">
                  
                  <!-- Container -->
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-yellow-500 to-orange-600 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                      </div>
                      <p class="text-slate-200 font-medium">
                        <%= shipment.container_number || 'N/A' %>
                      </p>
                    </div>
                  </td>

                  <!-- Booking Ref -->
                  <td class="py-4 px-4">
                    <span class="text-slate-300 font-mono text-sm"><%= shipment.booking_reference || '-' %></span>
                  </td>

                  <!-- Route -->
                  <td class="py-4 px-4">
                    <p class="text-slate-300 text-sm"><%= shipment.origin || '-' %></p>
                    <p class="text-slate-500 text-xs">→ <%= shipment.destination || '-' %></p>
                  </td>

                  <!-- Status -->
                  <td class="py-4 px-4">
                    <span class="px-3 py-1.5 rounded-full text-xs font-medium 
                      <%= case shipment.status
                        when 'delivered' then 'bg-green-500/20 text-green-400 border border-green-500/30'
                        when 'in_transit' then 'bg-blue-500/20 text-blue-400 border border-blue-500/30'
                        when 'pending' then 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30'
                        else 'bg-slate-600/30 text-slate-400 border border-slate-500/30'
                      end %>">
                      <%= shipment.status || 'pending' %>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="py-4 px-4">
                    <div class="flex gap-2 justify-end opacity-0 group-hover:opacity-100 transition-opacity">
                      
                      <a href="<%= admin_shipment_path(shipment) %>" 
                         class="p-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg transition-colors" title="View">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                      </a>

                      <a href="<%= edit_admin_shipment_path(shipment) %>" 
                         class="p-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg transition-colors" title="Edit">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      </a>

                      <%= button_to '', admin_shipment_path(shipment),
                        method: :delete,
                        class: 'p-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors cursor-pointer',
                        onclick: "confirmDelete(event, '#{shipment.container_number}')",
                        title: 'Delete' %>

                    </div>
                  </td>

                </tr>
              <% end %>
            </tbody>

          </table>
        </div>

      <% else %>

        <!-- Empty State -->
        <div class="text-center py-16">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
            <svg class="w-10 h-10 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
            </svg>
          </div>

          <h3 class="text-xl font-semibold text-slate-200 mb-2">No shipments yet</h3>
          <p class="text-slate-500 mb-6">
            Start tracking your first shipment
          </p>

          <a href="<%= new_admin_shipment_path %>" 
             class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-yellow-500 to-orange-600 hover:from-yellow-600 hover:to-orange-700 text-white rounded-xl font-medium transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Add First Shipment
          </a>
        </div>

      <% end %>
    </div>

  </div>
</div>