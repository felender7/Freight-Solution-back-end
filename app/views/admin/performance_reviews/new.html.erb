<header class="bg-slate-800 border-b border-slate-700 px-8 py-5">
  <h1 class="text-slate-100 text-2xl font-bold">New Performance Review</h1>
</header>

<div class="p-8">
  <a href="<%= admin_performance_reviews_path %>" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm mb-6">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to Reviews
  </a>

  <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden w-full">
    <div class="p-8">
      <%= form_with model: [:admin, @performance_review], local: true do |form| %>
        <% if @performance_review.errors.any? %>
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
            <ul class="list-disc list-inside">
              <% @performance_review.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Employee</label>
            <%= form.collection_select :employee_id, @employees, :id, ->(e) { "#{e.first_name} #{e.last_name}" }, { prompt: 'Select Employee' }, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Reviewer</label>
            <%= form.collection_select :reviewer_id, User.all, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { prompt: 'Select Reviewer' }, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Rating (1-5)</label>
            <%= form.number_field :rating, min: 1, max: 5, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Review Cycle</label>
            <%= form.text_field :review_cycle, placeholder: 'e.g., Q1 2024', class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Review Date</label>
            <%= form.date_field :review_date, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
            <%= form.select :status, options_for_select(['pending', 'in_progress', 'completed'], 'pending'), {}, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
          </div>
        </div>

        <div class="mb-8">
          <label class="block text-slate-300 text-sm font-medium mb-2.5">Feedback</label>
          <%= form.text_area :feedback, rows: 4, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500" %>
        </div>

        <div>
          <%= form.submit 'Create Review', class: "px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-all cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>