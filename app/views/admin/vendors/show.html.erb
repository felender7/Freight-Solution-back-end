<div class="p-8 animate-fade-in space-y-8">
  
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
    <!-- Header with Background Graphic -->
    <div class="relative px-8 py-10 bg-slate-800 border-b border-slate-700 overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-10">
        <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg shadow-blue-500/20">
            <%= @vendor.name[0] %>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-3xl font-bold text-slate-100"><%= @vendor.name %></h1>
              <span class="px-3 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-widest rounded-full border border-blue-500/30">
                <%= @vendor.category || 'Uncategorized' %>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-slate-400 text-sm">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <%= @vendor.email %>
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <%= @vendor.phone || 'N/A' %>
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="<%= edit_admin_vendor_path(@vendor) %>" 
             class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-600/20 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Edit Profile
          </a>
          <a href="<%= admin_vendors_path %>" 
             class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-medium transition-all flex items-center gap-2">
            Back to List
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x border-slate-700">
      <!-- Risk & Compliance Quick View -->
      <div class="p-8 bg-slate-800/30">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Risk & Compliance Score</h3>
        <div class="flex items-center justify-center p-6 mb-6 rounded-3xl bg-slate-900/50 border border-slate-700">
          <div class="text-center">
            <div class="text-5xl font-black <%= @vendor.risk_score < 30 ? 'text-green-500' : (@vendor.risk_score < 70 ? 'text-yellow-500' : 'text-red-500') %> mb-2">
              <%= @vendor.risk_score || 0 %><span class="text-lg text-slate-600 font-normal">/100</span>
            </div>
            <p class="text-slate-400 text-sm">Overall Risk Rating</p>
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/30 border border-slate-700/50">
            <span class="text-slate-300 text-sm">KYC Status</span>
            <span class="px-3 py-1 text-[10px] font-bold uppercase rounded-full 
              <%= case @vendor.kyc_status
                when 'verified' then 'bg-green-500/20 text-green-400'
                when 'pending' then 'bg-yellow-500/20 text-yellow-400'
                when 'rejected' then 'bg-red-500/20 text-red-400'
                else 'bg-slate-700 text-slate-400'
              end %>">
              <%= @vendor.kyc_status %>
            </span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/30 border border-slate-700/50">
            <span class="text-slate-300 text-sm">Contract Status</span>
            <span class="px-3 py-1 text-[10px] font-bold uppercase rounded-full 
              <%= case @vendor.contract_status
                when 'Active' then 'bg-green-500/20 text-green-400'
                when 'Expired' then 'bg-red-500/20 text-red-400'
                else 'bg-yellow-500/20 text-yellow-400'
              end %>">
              <%= @vendor.contract_status %>
            </span>
          </div>
        </div>
      </div>

      <!-- Core Details -->
      <div class="p-8 lg:col-span-2">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Vendor Overview</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
          <div>
            <label class="block text-slate-500 text-xs font-semibold uppercase mb-1">Registration Number</label>
            <p class="text-slate-200 font-mono"><%= @vendor.registration_number || 'Not Provided' %></p>
          </div>
          <div>
            <label class="block text-slate-500 text-xs font-semibold uppercase mb-1">VAT Number</label>
            <p class="text-slate-200 font-mono"><%= @vendor.vat_number || 'Not Registered' %></p>
          </div>
          <div>
            <label class="block text-slate-500 text-xs font-semibold uppercase mb-1">Bank Reference</label>
            <p class="text-slate-200"><%= @vendor.bank_reference || '-' %></p>
          </div>
          <div>
            <label class="block text-slate-500 text-xs font-semibold uppercase mb-1">Primary Status</label>
            <p class="text-slate-200 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full <%= @vendor.status == 'active' ? 'bg-green-500' : 'bg-red-500' %>"></span>
              <%= @vendor.status&.capitalize %>
            </p>
          </div>
          <div class="md:col-span-2">
            <label class="block text-slate-500 text-xs font-semibold uppercase mb-1">Address</label>
            <p class="text-slate-300 leading-relaxed"><%= @vendor.address || 'No physical address on file' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- KYC & FICA Standards -->
    <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
      <h3 class="text-lg font-bold text-slate-100 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        KYC (Bank Standard) & FICA
      </h3>
      
      <div class="grid grid-cols-1 gap-4">
        <% [
          ['FICA Compliant', @vendor.fica_compliant],
          ['AML Checks', @vendor.aml_checked],
          ['Sanctions Screening', @vendor.sanctions_screened],
          ['Bank Account Verified', @vendor.bank_verified],
          ['Beneficial Ownership Declaration', @vendor.beneficial_ownership_declared]
        ].each do |label, value| %>
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/50 border border-slate-700">
            <span class="text-slate-300 text-sm font-medium"><%= label %></span>
            <% if value %>
              <div class="flex items-center gap-1.5 text-green-400">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-xs font-bold uppercase tracking-tighter">Verified</span>
              </div>
            <% else %>
              <div class="flex items-center gap-1.5 text-slate-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-xs font-bold uppercase tracking-tighter italic">Required</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Document Management -->
    <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
      <h3 class="text-lg font-bold text-slate-100 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Compliance Documents
      </h3>
      
      <div class="space-y-3">
        <% [
          ['Company Registration', @vendor.company_registration_doc],
          ['Tax Clearance', @vendor.tax_clearance_doc],
          ['Insurance Certificate', @vendor.insurance_certificate_doc],
          ['Bank Confirmation Letter', @vendor.bank_confirmation_letter_doc],
          ['BBBEE Certificate', @vendor.bbbee_certificate_doc]
        ].each do |name, doc| %>
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/50 border border-slate-700 hover:bg-slate-900 transition-colors">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <span class="text-slate-300 text-sm font-medium"><%= name %></span>
            </div>
            <% if doc.attached? %>
              <%= link_to url_for(doc), target: '_blank', class: "px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-blue-400 text-[10px] font-bold uppercase rounded-lg transition-all" do %>
                Download
              <% end %>
            <% else %>
              <span class="text-slate-600 text-[10px] font-bold uppercase italic">Missing</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Contract & SLA Management -->
  <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
    <div class="flex items-center justify-between mb-8">
      <h3 class="text-xl font-bold text-slate-100 flex items-center gap-2">
        <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        Contract & SLA Management
      </h3>
      <div class="flex items-center gap-4">
        <div class="text-right">
          <label class="block text-slate-500 text-[10px] font-bold uppercase mb-1">Renewal Workflow</label>
          <div class="flex items-center gap-2">
            <span class="text-slate-200 text-sm font-medium"><%= @vendor.contract_end_date&.strftime('%b %d, %Y') || 'No End Date' %></span>
            <% if @vendor.contract_status == 'Expiring Soon' %>
              <span class="inline-flex h-2 w-2 rounded-full bg-red-500 animate-ping"></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div class="space-y-2">
        <label class="text-slate-500 text-xs font-bold uppercase">SLA Monitoring</label>
        <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700 min-h-[100px] text-slate-300 text-sm">
          <%= @vendor.sla_details.presence || 'No SLA performance criteria established' %>
        </div>
      </div>
      <div class="space-y-2">
        <label class="text-slate-500 text-xs font-bold uppercase">Rate Card Details</label>
        <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700 min-h-[100px] text-slate-300 text-sm">
          <%= @vendor.rate_card_details.presence || 'Pricing cards have not been uploaded' %>
        </div>
      </div>
      <div class="space-y-2">
        <label class="text-slate-500 text-xs font-bold uppercase">Penalty Clauses</label>
        <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700 min-h-[100px] text-slate-300 text-sm">
          <%= @vendor.penalty_clauses.presence || 'Standard terms apply - no special penalties' %>
        </div>
      </div>
    </div>

    <!-- Active Contracts & Versions -->
    <div class="border-t border-slate-700 pt-8">
      <label class="text-slate-500 text-xs font-bold uppercase mb-4 block">Version Tracking & Uploaded Contracts</label>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <% if @vendor.contracts.attached? %>
          <% @vendor.contracts.each_with_index do |contract, idx| %>
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-700 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="p-2 bg-purple-500/10 text-purple-400 rounded-lg font-bold text-[10px]">
                  v<%= idx + 1 %>
                </div>
                <div>
                  <p class="text-slate-200 text-xs font-semibold truncate max-w-[120px]"><%= contract.filename %></p>
                  <p class="text-slate-500 text-[10px]"><%= number_to_human_size(contract.byte_size) %></p>
                </div>
              </div>
              <%= link_to url_for(contract), target: '_blank', class: "p-2 hover:bg-slate-700 text-slate-400 rounded-lg transition-all" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="col-span-full py-8 border-2 border-dashed border-slate-700 rounded-2xl text-center">
            <p class="text-slate-500 text-sm">No signed contracts on file for version tracking</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
