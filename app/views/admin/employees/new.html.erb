<div class="p-8">
  <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden w-full">
    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-100">New Employee</h1>
        <p class="text-slate-400 text-sm mt-1">Fill in the details to create a new employee record</p>
      </div>

      <a href="<%= admin_employees_path %>" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
      </a>
    </div>

    <!-- Form -->
    <div class="p-8">
      <%= render 'form', employee: @employee %>
    </div>
  </div>
</div>
