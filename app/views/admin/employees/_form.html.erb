<%= form_with model: [:admin, employee], local: true, class: "space-y-8" do |form| %>
  <% if employee.errors.any? %>
    <div class="p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
      <ul class="list-disc list-inside">
        <% employee.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Basic Details -->
  <section>
    <h3 class="text-lg font-semibold text-slate-200 mb-4 border-b border-slate-700 pb-2">Basic Details</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :first_name, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :first_name, required: true, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :last_name, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :last_name, required: true, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :email, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.email_field :email, required: true, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :phone, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :phone, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
    </div>
  </section>

  <!-- Profile Photo -->
  <section>
    <h3 class="text-lg font-semibold text-slate-200 mb-4 border-b border-slate-700 pb-2">Candidate Details</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :profile_photo, "Profile Photo", class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.file_field :profile_photo, class: "w-full text-slate-400 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-500/10 file:text-blue-400 hover:file:bg-blue-500/20" %>
        <% if employee.profile_photo.attached? %>
          <p class="text-xs text-green-400 mt-1">Photo currently attached</p>
        <% end %>
      </div>
      <div>
        <%= form.label :user_id, "Associate User Account", class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.collection_select :user_id, User.order(:email), :id, :email, { include_blank: "Select User" }, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
    </div>
  </section>

  <!-- Address Details -->
  <section>
    <h3 class="text-lg font-semibold text-slate-200 mb-4 border-b border-slate-700 pb-2">Address Details</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= form.label :address, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :address, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :city, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :city, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :state, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :state, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :country, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :country, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :zip_code, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :zip_code, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
    </div>
  </section>

  <!-- Professional Details -->
  <section>
    <h3 class="text-lg font-semibold text-slate-200 mb-4 border-b border-slate-700 pb-2">Professional Details</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :employee_code, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :employee_code, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :position, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :position, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :department, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.text_field :department, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :employment_status, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.select :employment_status, ["Full-time", "Part-time", "Contract", "Intern"], { include_blank: "Select Status" }, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :manager_id, "Reporting Manager", class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.collection_select :manager_id, Employee.where.not(id: employee.id).order(:first_name), :id, :full_name, { include_blank: "None" }, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :salary, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.number_field :salary, step: '0.01', class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
      <div>
        <%= form.label :hire_date, class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.date_field :hire_date, class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
      </div>
    </div>
  </section>

  <!-- Educational Background -->
  <section>
    <h3 class="text-lg font-semibold text-slate-200 mb-4 border-b border-slate-700 pb-2">Educational Background</h3>
    <div>
      <%= form.label :education_background, class: "block text-slate-300 text-sm font-medium mb-2" %>
      <%= form.text_area :education_background, rows: 4, placeholder: "Degree, Institution, Year, etc.", class: "w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none" %>
    </div>
  </section>

  <!-- Onboarding Documents -->
  <section>
    <h3 class="text-lg font-semibold text-slate-200 mb-4 border-b border-slate-700 pb-2">Onboarding Documents</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :contract, "Employment Contract", class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.file_field :contract, class: "w-full text-slate-400 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-500/10 file:text-blue-400 hover:file:bg-blue-500/20" %>
        <% if employee.contract.attached? %>
          <p class="text-xs text-green-400 mt-1">Contract currently attached</p>
        <% end %>
      </div>
      <div>
        <%= form.label :appointment_letter, "Appointment Letter", class: "block text-slate-300 text-sm font-medium mb-2" %>
        <%= form.file_field :appointment_letter, class: "w-full text-slate-400 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-500/10 file:text-blue-400 hover:file:bg-blue-500/20" %>
        <% if employee.appointment_letter.attached? %>
          <p class="text-xs text-green-400 mt-1">Appointment letter currently attached</p>
        <% end %>
      </div>
    </div>
  </section>

  <div class="pt-6 border-t border-slate-700">
    <%= form.submit class: "px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors cursor-pointer" %>
  </div>
<% end %>
