<div class="p-8">
  <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden w-full">
    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <% if @employee.profile_photo.attached? %>
          <img src="<%= url_for(@employee.profile_photo) %>" class="w-20 h-20 rounded-full object-cover border-2 border-slate-600" alt="Profile">
        <% else %>
          <div class="w-20 h-20 rounded-full bg-slate-700 flex items-center justify-center border-2 border-slate-600">
            <span class="text-2xl text-slate-400 font-bold"><%= @employee.first_name[0] %><%= @employee.last_name[0] %></span>
          </div>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-slate-100"><%= @employee.full_name %></h1>
          <p class="text-slate-400 text-sm mt-1"><%= @employee.position %> • <%= @employee.department %></p>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 mt-2">
            <%= @employee.employment_status || 'Status Unknown' %>
          </span>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <a href="<%= edit_admin_employee_path(@employee) %>" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">Edit Profile</a>
        <a href="<%= admin_employees_path %>" class="px-4 py-2 border border-slate-600 text-slate-300 hover:bg-slate-700 rounded-lg transition-colors">Back</a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 p-8">
      <!-- Contact & Personal -->
      <div class="space-y-6">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">Contact Information</h3>
        <div class="space-y-4">
          <div>
            <p class="text-xs text-slate-500">Email Address</p>
            <p class="text-slate-200"><%= @employee.email %></p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Phone Number</p>
            <p class="text-slate-200"><%= @employee.phone.presence || 'N/A' %></p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Mailing Address</p>
            <p class="text-slate-200">
              <%= @employee.address %><br>
              <%= @employee.city %>, <%= @employee.state %> <%= @employee.zip_code %><br>
              <%= @employee.country %>
            </p>
          </div>
        </div>
      </div>

      <!-- Professional & Job -->
      <div class="space-y-6">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">Professional Details</h3>
        <div class="space-y-4">
          <div>
            <p class="text-xs text-slate-500">Employee ID</p>
            <p class="text-slate-200"><%= @employee.employee_code.presence || 'N/A' %></p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Reporting Manager</p>
            <p class="text-slate-200"><%= @employee.manager&.full_name || 'None' %></p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Salary</p>
            <p class="text-slate-200"><%= number_to_currency(@employee.salary) %></p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Hire Date</p>
            <p class="text-slate-200"><%= @employee.hire_date&.strftime('%B %d, %Y') || 'N/A' %></p>
          </div>
        </div>
      </div>

      <!-- Education & Documents -->
      <div class="space-y-6">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">Education & Documents</h3>
        <div class="space-y-4">
          <div>
            <p class="text-xs text-slate-500">Educational Background</p>
            <p class="text-slate-200 whitespace-pre-line"><%= @employee.education_background.presence || 'N/A' %></p>
          </div>
          <div class="pt-4 space-y-3">
            <% if @employee.contract.attached? %>
              <a href="<%= url_for(@employee.contract) %>" target="_blank" class="flex items-center gap-2 text-blue-400 hover:text-blue-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                Employment Contract
              </a>
            <% end %>
            <% if @employee.appointment_letter.attached? %>
              <a href="<%= url_for(@employee.appointment_letter) %>" target="_blank" class="flex items-center gap-2 text-blue-400 hover:text-blue-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                Appointment Letter
              </a>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
