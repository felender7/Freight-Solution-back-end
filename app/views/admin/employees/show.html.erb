<div class="p-8 animate-fade-in space-y-8">
  
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
    <!-- Header with Background Graphic -->
    <div class="relative px-8 py-10 bg-slate-800 border-b border-slate-700 overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-10 text-indigo-500">
        <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <% if @employee.profile_photo.attached? %>
            <img src="<%= url_for(@employee.profile_photo) %>" class="w-20 h-20 rounded-2xl object-cover border-2 border-slate-600 shadow-lg shadow-indigo-500/20" alt="Profile">
          <% else %>
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-indigo-500/20">
              <%= @employee.first_name[0] %><%= @employee.last_name[0] %>
            </div>
          <% end %>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-3xl font-black text-slate-100 tracking-tight uppercase"><%= @employee.full_name %></h1>
              <span class="px-3 py-1 bg-indigo-500/20 text-indigo-400 text-[10px] font-black uppercase tracking-widest rounded-full border border-indigo-500/30">
                <%= @employee.employment_status || 'Active' %>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-slate-400 text-sm">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <%= @employee.position %> • <%= @employee.department %>
              </span>
              <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-tighter">
                ID: <%= @employee.employee_code || 'N/A' %>
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="<%= edit_admin_employee_path(@employee) %>" 
             class="px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg shadow-blue-500/25 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Edit Profile
          </a>
          <a href="<%= admin_employees_path %>" 
             class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all flex items-center gap-2">
            Back to Registry
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x border-slate-700">
      <!-- Contact Quick View -->
      <div class="p-8 bg-slate-800/30">
        <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-6">Contact & Outreach</h3>
        
        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50 shadow-inner">
            <label class="block text-slate-500 text-[8px] font-black uppercase mb-1">Email Channel</label>
            <p class="text-slate-200 text-sm font-bold truncate"><%= @employee.email %></p>
          </div>
          
          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50 shadow-inner">
            <label class="block text-slate-500 text-[8px] font-black uppercase mb-1">Mobile Contact</label>
            <p class="text-slate-200 text-sm font-bold"><%= @employee.phone.presence || 'N/A' %></p>
          </div>

          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50 shadow-inner">
            <label class="block text-slate-500 text-[8px] font-black uppercase mb-1">Reporting Structure</label>
            <div class="flex items-center gap-2 mt-1">
              <div class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center text-[10px] text-blue-400 font-bold border border-slate-700">
                <%= @employee.manager&.first_name&.get(0) || 'S' %>
              </div>
              <p class="text-slate-200 text-xs font-medium"><%= @employee.manager&.full_name || 'System / Direct' %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Professional Snapshot -->
      <div class="p-8 lg:col-span-2">
        <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-6">Employment Summary</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 shadow-inner">
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-2">Annual Remuneration</label>
            <p class="text-4xl font-black text-slate-100">
              <%= number_to_currency(@employee.salary, unit: 'R', delimiter: ' ', precision: 0) %>
            </p>
            <p class="mt-2 text-[10px] text-slate-500 font-bold uppercase">Basic CTC (excluding performance bonus)</p>
          </div>
          
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 shadow-inner">
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-2">Tenure Metrics</label>
            <p class="text-xl font-black text-indigo-400">
              <%= @employee.hire_date&.strftime('%d %B %Y') || 'N/A' %>
            </p>
            <p class="mt-2 text-[10px] text-slate-500 font-bold uppercase">Hire date / Commencement</p>
          </div>

          <div class="md:col-span-2 space-y-4 pt-4 border-t border-slate-700/50">
             <label class="block text-slate-500 text-[10px] font-black uppercase tracking-widest">Primary Office Location</label>
             <p class="text-slate-300 text-sm leading-relaxed">
               <%= @employee.address %><br>
               <span class="text-slate-500"><%= @employee.city %>, <%= @employee.state %> <%= @employee.zip_code %> • <%= @employee.country %></span>
             </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Education & Skills -->
    <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
      <h3 class="text-lg font-black text-slate-100 mb-6 flex items-center gap-2 uppercase tracking-widest">
        <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.083 0 01.665-6.479L12 14z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.083 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>
        Educational Dossier
      </h3>
      
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 relative overflow-hidden group min-h-[140px]">
        <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
           <svg class="w-24 h-24 text-indigo-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"/></svg>
        </div>
        <p class="text-slate-300 leading-relaxed text-sm relative z-10">
          <%= @employee.education_background.presence || 'No formal educational background record found on file.' %>
        </p>
      </div>
    </div>

    <!-- Personnel Records: Compliance Docs -->
    <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
      <h3 class="text-lg font-black text-slate-100 mb-6 flex items-center gap-2 uppercase tracking-widest">
        <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V21a2 2 0 01-2 2h-6a2 2 0 01-2-2v-5m-2-4h5m-5 4h3"/></svg>
        Personnel Records
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% [
          ['Employment Contract', @employee.contract],
          ['Appointment Letter', @employee.appointment_letter]
        ].each do |name, doc| %>
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-700 hover:border-slate-500 transition-all group">
            <div class="flex items-center justify-between mb-3">
              <div class="p-2 rounded-lg bg-slate-800 text-slate-400 group-hover:bg-blue-500 group-hover:text-white transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              </div>
              <% if doc.attached? %>
                <span class="text-[8px] font-black uppercase text-green-500 bg-green-500/10 px-2 py-0.5 rounded">Archived</span>
              <% else %>
                <span class="text-[8px] font-black uppercase text-red-500 bg-red-500/10 px-2 py-0.5 rounded">Missing</span>
              <% end %>
            </div>
            <p class="text-slate-300 text-xs font-bold mb-3"><%= name %></p>
            <% if doc.attached? %>
              <%= link_to url_for(doc), target: '_blank', class: "block w-full py-2 text-center bg-slate-800 hover:bg-slate-700 text-blue-400 text-[10px] font-black uppercase rounded-lg border border-slate-700 transition-all" do %>
                Download PDF
              <% end %>
            <% else %>
              <div class="w-full py-2 text-center bg-slate-800/50 text-slate-600 text-[10px] font-black uppercase rounded-lg border border-slate-700 cursor-not-allowed italic">
                Awaiting Upload
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
