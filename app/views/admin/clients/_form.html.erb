<%= form_with model: [:admin, client], local: true, class: "space-y-8" do |form| %>

  <% if client.errors.any? %>
    <div class="p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
      <ul class="list-disc list-inside">
        <% client.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Section 1: Basic Information -->
  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700 shadow-inner">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      Basic Information
    </h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Client Name / Entity</label>
        <%= form.text_field :name, required: true,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Email Address</label>
        <%= form.email_field :email, required: true,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Phone Number</label>
        <%= form.text_field :phone,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Category</label>
        <%= form.select :category, Client::CATEGORIES, { include_blank: "Select Category" },
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>

      <div class="md:col-span-2">
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Physical Address</label>
        <%= form.text_area :address, rows: 2,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
    </div>
  </div>

  <!-- Section 2: KYC & Compliance -->
  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
      </svg>
      KYC (Bank-Compliant Onboarding)
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Registration Number (CIPC)</label>
        <%= form.text_field :registration_number,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">VAT Number</label>
        <%= form.text_field :vat_number,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">KYC Status</label>
        <%= form.select :kyc_status, Client::KYC_STATUSES, {},
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div class="flex items-center gap-6 pt-8">
        <div class="flex items-center gap-2">
          <%= form.check_box :fica_compliant, class: "w-4 h-4 rounded border-slate-600 bg-slate-900 text-blue-500" %>
          <label class="text-slate-300 text-sm">FICA Compliant</label>
        </div>
        <div class="flex items-center gap-2">
          <%= form.check_box :aml_checked, class: "w-4 h-4 rounded border-slate-600 bg-slate-900 text-blue-500" %>
          <label class="text-slate-300 text-sm">AML Verified</label>
        </div>
      </div>
    </div>

    <!-- Document Uploads -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="space-y-2">
        <label class="block text-slate-400 text-xs font-bold uppercase">Company Registration Docs</label>
        <%= form.file_field :registration_doc, class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500/20 file:text-yellow-500 hover:file:bg-yellow-500/30 transition-all" %>
      </div>
      <div class="space-y-2">
        <label class="block text-slate-400 text-xs font-bold uppercase">Director ID Copies</label>
        <%= form.file_field :director_id_doc, class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500/20 file:text-yellow-500 hover:file:bg-yellow-500/30 transition-all" %>
      </div>
      <div class="space-y-2">
        <label class="block text-slate-400 text-xs font-bold uppercase">Bank Confirmation Letter</label>
        <%= form.file_field :bank_confirmation_doc, class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500/20 file:text-yellow-500 hover:file:bg-yellow-500/30 transition-all" %>
      </div>
      <div class="space-y-2">
        <label class="block text-slate-400 text-xs font-bold uppercase">Tax Compliance Status</label>
        <%= form.file_field :tax_compliance_doc, class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500/20 file:text-yellow-500 hover:file:bg-yellow-500/30 transition-all" %>
      </div>
      <div class="space-y-2">
        <label class="block text-slate-400 text-xs font-bold uppercase">Proof of Address</label>
        <%= form.file_field :proof_of_address_doc, class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500/20 file:text-yellow-500 hover:file:bg-yellow-500/30 transition-all" %>
      </div>
      <div class="space-y-2">
        <label class="block text-slate-400 text-xs font-bold uppercase">Trade References</label>
        <%= form.file_field :trade_references_docs, multiple: true, class: "block w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500/20 file:text-yellow-500 hover:file:bg-yellow-500/30 transition-all" %>
      </div>
    </div>
  </div>

  <!-- Section 3: Financial Profiling -->
  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Financial Profiling & Risk
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Credit Limit (R)</label>
        <%= form.number_field :credit_limit, step: 0.01,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Payment Terms</label>
        <%= form.select :payment_terms, Client::PAYMENT_TERMS, { include_blank: "Select Terms" },
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Risk Category</label>
        <%= form.select :risk_category, Client::RISK_CATEGORIES, { include_blank: "Evaluate Risk" },
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">FX Exposure Limit (R)</label>
        <%= form.number_field :fx_exposure, step: 0.01,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Credit Score (0-100)</label>
        <%= form.number_field :credit_score, min: 0, max: 100,
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
        <%= form.select :status, ['active', 'inactive', 'on_hold'], {},
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-4 pt-6">
    <%= form.submit (client.new_record? ? 'Onboard Client' : 'Update Profile'),
      class: "px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 text-white rounded-lg font-bold transition-all cursor-pointer shadow-lg shadow-blue-500/20 uppercase text-xs tracking-widest" %>

    <a href="<%= admin_clients_path %>" 
       class="px-8 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-bold transition-all uppercase text-xs tracking-widest">
      Cancel
    </a>
  </div>

<% end %>
