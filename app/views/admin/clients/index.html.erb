<div class="animate-fade-in p-8">

  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      
      <!-- Left -->
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span>Clients</span>
        </div>

        <h1 class="text-3xl font-bold text-slate-100  tracking-tight">Client Management System</h1>
        <p class="text-slate-400 mt-1">
          Manage categorization, KYC compliance, and financial profiling
        </p>
      </div>

      <!-- Right -->
      <a href="<%= new_admin_client_path %>" 
         class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800 text-white rounded-xl font-bold transition-all shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 uppercase text-xs tracking-widest">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Onboard New Client
      </a>
    </div>

    <!-- Notice -->
    <% if notice %>
      <div class="px-8 pt-6">
        <div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg animate-fade-in flex items-center gap-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <%= notice %>
        </div>
      </div>
    <% end %>

    <!-- Table -->
    <div class="p-6">
      <% if @clients.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            
            <thead>
              <tr class="border-b border-slate-700/30">
                <th class="text-left text-slate-500 text-xs font-bold uppercase tracking-widest py-4 px-4">Client / Category</th>
                <th class="text-left text-slate-500 text-xs font-bold uppercase tracking-widest py-4 px-4">KYC Compliance</th>
                <th class="text-left text-slate-500 text-xs font-bold uppercase tracking-widest py-4 px-4">Risk Profile</th>
                <th class="text-left text-slate-500 text-xs font-bold uppercase tracking-widest py-4 px-4">Financial Status</th>
                <th class="text-right text-slate-500 text-xs font-bold uppercase tracking-widest py-4 px-4">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @clients.each do |client| %>
                <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors group">
                  
                  <!-- Client & Category -->
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-4">
                      <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-indigo-500 font-bold text-lg group-hover:bg-indigo-600 group-hover:text-white transition-all">
                        <%= client.name[0] %>
                      </div>
                      <div>
                        <p class="text-slate-100 font-bold text-base"><%= client.name %></p>
                        <span class="text-[10px] font-black uppercase text-slate-500 tracking-tighter bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
                          <%= client.category || 'Unassigned' %>
                        </span>
                      </div>
                    </div>
                  </td>

                  <!-- KYC Compliance -->
                  <td class="py-4 px-4">
                    <div class="flex flex-col gap-1.5">
                      <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full <%= case client.kyc_status
                          when 'verified' then 'bg-green-500'
                          when 'pending' then 'bg-yellow-500'
                          when 'rejected' then 'bg-red-500'
                          else 'bg-slate-600'
                        end %>"></span>
                        <span class="text-xs font-bold text-slate-300 uppercase tracking-tight"><%= client.kyc_status %></span>
                      </div>
                      <div class="flex gap-1.5">
                        <span class="w-4 h-4 <%= client.fica_compliant ? 'text-green-500' : 'text-slate-700' %>" title="FICA Compliance">
                          <svg fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/></svg>
                        </span>
                        <span class="w-4 h-4 <%= client.aml_checked ? 'text-blue-500' : 'text-slate-700' %>" title="AML Verified">
                          <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        </span>
                        <span class="w-4 h-4 <%= client.bank_verified ? 'text-yellow-500' : 'text-slate-700' %>" title="Bank Verified">
                          <svg fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
                        </span>
                      </div>
                    </div>
                  </td>

                  <!-- Risk Profile -->
                  <td class="py-4 px-4">
                    <span class="px-3 py-1.5 rounded-xl text-[10px] font-bold uppercase tracking-widest border
                      <%= case client.risk_category
                        when 'Low' then 'bg-green-500/10 text-green-400 border-green-500/30'
                        when 'Medium' then 'bg-blue-500/10 text-blue-400 border-blue-500/30'
                        when 'High' then 'bg-yellow-500/10 text-yellow-400 border-yellow-500/30'
                        when 'Critical' then 'bg-red-500/10 text-red-400 border-red-500/30'
                        else 'bg-slate-800 text-slate-500 border-slate-700'
                      end %>">
                      <%= client.risk_category || 'Unrated' %>
                    </span>
                  </td>

                  <!-- Financial Status -->
                  <td class="py-4 px-4">
                    <p class="text-slate-100 text-sm font-bold">Limit: R<%= number_with_precision(client.credit_limit, precision: 0) %></p>
                    <p class="text-[10px] text-slate-500 uppercase font-black"><%= client.payment_terms %></p>
                  </td>

                  <!-- Actions -->
                  <td class="py-4 px-4">
                    <div class="flex gap-2 justify-end opacity-0 group-hover:opacity-100 transition-all">
                      
                      <a href="<%= admin_client_path(client) %>" 
                         class="p-2.5 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-xl transition-colors border border-slate-700 shadow-lg" title="View Full Profile">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                      </a>

                      <a href="<%= edit_admin_client_path(client) %>" 
                         class="p-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl transition-colors border border-slate-700 shadow-lg" title="Edit Profile">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      </a>

                      <%= button_to admin_client_path(client),
                        method: :delete,
                        form: { class: 'inline-block', data: { turbo: false, confirm: "Are you sure you want to delete '#{client.name}' and all financial/KYC history?" } },
                        class: 'p-2.5 bg-slate-800 hover:bg-red-900/50 text-red-500 rounded-xl transition-all border border-slate-700 shadow-lg',
                        title: 'Delete Client' do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>

                    </div>
                  </td>

                </tr>
              <% end %>
            </tbody>

          </table>
        </div>

      <% else %>

        <!-- Empty State -->
        <div class="text-center py-24">
          <div class="w-24 h-24 mx-auto mb-8 rounded-3xl bg-slate-900 border-2 border-dashed border-slate-700 flex items-center justify-center">
            <svg class="w-12 h-12 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-slate-200 mb-2 tracking-tight">No Clients Registered</h3>
          <p class="text-slate-500 mb-8 max-w-sm mx-auto">
            Start by onboarding your first client to manage their trade compliance and credit terms.
          </p>

          <a href="<%= new_admin_client_path %>" 
             class="inline-flex items-center gap-2 px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-all shadow-xl shadow-blue-500/20 uppercase text-xs tracking-widest">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Onboard First Client
          </a>
        </div>

      <% end %>
    </div>

  </div>
</div>
