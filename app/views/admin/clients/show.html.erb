<div class="p-8 animate-fade-in space-y-8">
  
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
    <!-- Header with Background Graphic -->
    <div class="relative px-8 py-10 bg-slate-800 border-b border-slate-700 overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-10">
        <svg class="w-32 h-32 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-blue-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg shadow-indigo-500/20">
            <%= @client.name[0] %>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-3xl font-bold text-slate-100"><%= @client.name %></h1>
              <span class="px-3 py-1 bg-indigo-500/20 text-indigo-400 text-xs font-bold uppercase tracking-widest rounded-full border border-indigo-500/30">
                <%= @client.category || 'Uncategorized' %>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-slate-400 text-sm">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <%= @client.email %>
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <%= @client.phone || 'N/A' %>
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="<%= edit_admin_client_path(@client) %>" 
             class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Edit Profile
          </a>
          <a href="<%= admin_clients_path %>" 
             class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-medium transition-all flex items-center gap-2">
            Back to List
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x border-slate-700">
      <!-- Financial Risk Profile -->
      <div class="p-8 bg-slate-800/30">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Financial Risk Analysis</h3>
        <div class="flex items-center justify-center p-6 mb-6 rounded-3xl bg-slate-900/50 border border-slate-700">
          <div class="text-center">
            <div class="text-5xl font-black 
              <%= case @client.financial_risk_profile
                when 'Low' then 'text-green-500'
                when 'Medium' then 'text-blue-500'
                when 'High' then 'text-yellow-500'
                when 'Critical' then 'text-red-500'
                else 'text-slate-500'
              end %> mb-2">
              <%= @client.credit_score || 0 %><span class="text-lg text-slate-600 font-normal">/100</span>
            </div>
            <p class="text-slate-400 text-sm font-bold uppercase tracking-tight">Credit Standing: <%= @client.financial_risk_profile %></p>
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/30 border border-slate-700/50">
            <span class="text-slate-400 text-xs font-bold uppercase">KYC Status</span>
            <span class="px-3 py-1 text-[10px] font-black uppercase rounded-lg border
              <%= case @client.kyc_status
                when 'verified' then 'bg-green-500/10 text-green-400 border-green-500/20'
                when 'pending' then 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
                when 'rejected' then 'bg-red-500/10 text-red-400 border-red-500/20'
                else 'bg-slate-700 text-slate-400'
              end %>">
              <%= @client.kyc_status %>
            </span>
          </div>
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/30 border border-slate-700/50">
            <span class="text-slate-400 text-xs font-bold uppercase">Payment Terms</span>
            <span class="text-slate-200 text-sm font-bold"><%= @client.payment_terms || 'N/A' %></span>
          </div>
        </div>
      </div>

      <!-- Financial Limits & Exposure -->
      <div class="p-8 lg:col-span-2">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Financial Profiling & Exposure</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 shadow-inner">
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-2">Credit Limit Assignment</label>
            <p class="text-3xl font-bold text-slate-100">R<%= number_with_precision(@client.credit_limit, precision: 2, delimiter: ' ') %></p>
            <div class="mt-4 w-full bg-slate-800 rounded-full h-1.5">
              <div class="bg-indigo-500 h-1.5 rounded-full" style="width: 45%"></div>
            </div>
            <p class="mt-2 text-[10px] text-slate-500">45% Utilization recorded</p>
          </div>
          
          <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 shadow-inner">
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-2">FX Exposure Monitoring</label>
            <p class="text-3xl font-bold text-blue-400">R<%= number_with_precision(@client.fx_exposure, precision: 2, delimiter: ' ') %></p>
            <div class="flex items-center gap-2 mt-4 text-[10px] text-slate-400 font-bold uppercase">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              Exposure within safe limits
            </div>
          </div>

          <div class="md:col-span-2 grid grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-slate-700/50">
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">Registration #</label>
              <p class="text-slate-200 font-mono text-sm"><%= @client.registration_number || '-' %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">VAT Number</label>
              <p class="text-slate-200 font-mono text-sm"><%= @client.vat_number || '-' %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">Risk Category</label>
              <p class="text-slate-200 text-sm font-bold"><%= @client.risk_category || 'Evaluating...' %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">Member Since</label>
              <p class="text-slate-200 text-sm font-bold"><%= @client.created_at.strftime('%b %Y') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- KYC Bank-Standard Checklist -->
    <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
      <h3 class="text-lg font-bold text-slate-100 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        KYC Compliance Matrix
      </h3>
      
      <div class="space-y-3">
        <% [
          ['FICA (South Africa) Alignment', @client.fica_compliant],
          ['AML (Anti-Money Laundering) Checks', @client.aml_checked],
          ['Sanctions screening', @client.sanctions_screened],
          ['Bank account verification', @client.bank_verified]
        ].each do |label, value| %>
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/50 border border-slate-700">
            <span class="text-slate-300 text-sm font-medium"><%= label %></span>
            <% if value %>
              <div class="flex items-center gap-1.5 text-green-400 bg-green-400/10 px-3 py-1 rounded-full border border-green-400/20">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-[10px] font-black uppercase">Cleared</span>
              </div>
            <% else %>
              <div class="flex items-center gap-1.5 text-slate-500 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">
                <span class="text-[10px] font-black uppercase italic">Pending</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Repository: Compliance Docs -->
    <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
      <h3 class="text-lg font-bold text-slate-100 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V21a2 2 0 01-2 2h-6a2 2 0 01-2-2v-5m-2-4h5m-5 4h3"/></svg>
        Document Repository
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% [
          ['Registration Docs', @client.registration_doc],
          ['Director ID Copies', @client.director_id_doc],
          ['Bank Confirmation', @client.bank_confirmation_doc],
          ['Tax Compliance', @client.tax_compliance_doc],
          ['Proof of Address', @client.proof_of_address_doc]
        ].each do |name, doc| %>
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-700 hover:border-slate-500 transition-all group">
            <div class="flex items-center justify-between mb-3">
              <div class="p-2 rounded-lg bg-slate-800 text-slate-400 group-hover:bg-blue-500 group-hover:text-white transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              </div>
              <% if doc.attached? %>
                <span class="text-[8px] font-black uppercase text-green-500 bg-green-500/10 px-2 py-0.5 rounded">Uploaded</span>
              <% else %>
                <span class="text-[8px] font-black uppercase text-red-500 bg-red-500/10 px-2 py-0.5 rounded">Missing</span>
              <% end %>
            </div>
            <p class="text-slate-300 text-xs font-bold mb-3"><%= name %></p>
            <% if doc.attached? %>
              <%= link_to url_for(doc), target: '_blank', class: "block w-full py-2 text-center bg-slate-800 hover:bg-slate-700 text-blue-400 text-[10px] font-black uppercase rounded-lg border border-slate-700 transition-all" do %>
                Download File
              <% end %>
            <% else %>
              <div class="w-full py-2 text-center bg-slate-800/50 text-slate-600 text-[10px] font-black uppercase rounded-lg border border-slate-700 cursor-not-allowed italic">
                Awaiting File
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Trade References -->
  <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 p-8 shadow-xl">
    <h3 class="text-xl font-bold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      Industry & Trade References
    </h3>
    
    <% if @client.trade_references_docs.attached? %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <% @client.trade_references_docs.each do |ref| %>
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900 border border-slate-700">
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <span class="text-slate-300 text-xs font-medium truncate max-w-[100px]"><%= ref.filename %></span>
            </div>
            <%= link_to url_for(ref), target: '_blank', class: "text-blue-400 hover:text-blue-300" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-12 border-2 border-dashed border-slate-700 rounded-3xl text-center">
        <p class="text-slate-500 text-sm italic">No trade references have been uploaded to the repository yet.</p>
      </div>
    <% end %>
  </div>
</div>
