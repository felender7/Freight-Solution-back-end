<%= form_with model: [:admin, leave_request], local: true, class: "space-y-8" do |form| %>

  <% if leave_request.errors.any? %>
    <div class="p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
      <ul class="list-disc list-inside text-sm">
        <% leave_request.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Section 1: Employee & Leave Type -->
  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      Employee & Leave Specification
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Employee</label>
        <%= form.collection_select :employee_id, Employee.all, :id, ->(e) { "#{e.first_name} #{e.last_name}" }, 
          { prompt: 'Select Employee' }, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Leave Type</label>
        <%= form.select :leave_type, ['sick', 'annual', 'maternity', 'paternity', 'unpaid'], 
          { prompt: 'Select Type' }, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>
    </div>
  </div>

  <!-- Section 2: Duration & Reason -->
  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      Duration & Details
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Start Date</label>
        <%= form.date_field :start_date, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">End Date</label>
        <%= form.date_field :end_date, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div class="md:col-span-2">
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Reason for Leave</label>
        <%= form.text_area :reason, rows: 3, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none",
          placeholder: "Provide context for this request..." %>
      </div>
    </div>
  </div>

  <!-- Section 3: Approval Status -->
  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Workflow Management
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Request Status</label>
        <%= form.select :status, ['pending', 'approved', 'rejected'], {}, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Decision Maker (Approved By)</label>
        <%= form.collection_select :approved_by_id, User.all, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, 
          { prompt: 'Select Approver', include_blank: true }, 
          class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="pt-6 border-t border-slate-700 flex gap-4">
    <%= form.submit (leave_request.new_record? ? "Create Request" : "Update Request"), 
        class: "flex-1 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25 cursor-pointer" %>
    <a href="<%= admin_leave_requests_path %>" 
       class="px-8 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-medium transition-all text-center flex items-center justify-center">
      Cancel
    </a>
  </div>

<% end %>
