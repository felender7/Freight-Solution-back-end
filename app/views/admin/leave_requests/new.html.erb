<header class="bg-slate-800 border-b border-slate-700 px-8 py-5">
  <h1 class="text-slate-100 text-2xl font-bold">New Leave Request</h1>
</header>

<div class="p-8">
  <a href="<%= admin_leave_requests_path %>" class="inline-flex items-center gap-2 text-blue-400 text-sm mb-6">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back
  </a>

  <div class="bg-slate-800 rounded-xl border border-slate-700 w-full">
    <div class="p-8">
      <%= form_with model: [:admin, @leave_request], local: true do |form| %>
        <% if @leave_request.errors.any? %>
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
            <ul class="list-disc list-inside"><% @leave_request.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
          </div>
        <% end %>
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Employee</label>
            <%= form.collection_select :employee_id, @employees, :id, ->(e) { "#{e.first_name} #{e.last_name}" }, { prompt: 'Select' }, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Leave Type</label>
            <%= form.select :leave_type, options_for_select(['sick', 'annual', 'maternity', 'paternity', 'unpaid'], 'annual'), {}, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Start Date</label>
            <%= form.date_field :start_date, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">End Date</label>
            <%= form.date_field :end_date, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6 mb-8">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
            <%= form.select :status, options_for_select(['pending', 'approved', 'rejected'], 'pending'), {}, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
        </div>
        <div class="mb-8">
          <label class="block text-slate-300 text-sm font-medium mb-2.5">Reason</label>
          <%= form.text_area :reason, rows: 3, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
        </div>
        <%= form.submit 'Create Request', class: "px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium" %>
      <% end %>
    </div>
  </div>
</div>