<div class="animate-fade-in p-8">

  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span>Leave Requests</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-100">Leave Requests</h1>
        <p class="text-slate-400 mt-1">Manage employee leave requests</p>
      </div>

      <a href="<%= new_admin_leave_request_path %>" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
        Add Request
      </a>
    </div>

    <% if notice %><div class="px-8 pt-6"><div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg"><%= notice %></div></div><% end %>

    <div class="p-6">
      <% if @leave_requests.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-slate-700/30">
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Employee</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Type</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Dates</th>
                <th class="text-left text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Status</th>
                <th class="text-right text-slate-500 text-xs font-semibold uppercase tracking-wider py-4 px-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @leave_requests.each do |leave| %>
                <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors group">
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm">
                        <%= leave.employee.first_name[0] %><%= leave.employee.last_name[0] %>
                      </div>
                      <p class="text-slate-200 font-medium"><%= leave.employee.first_name %> <%= leave.employee.last_name %></p>
                    </div>
                  </td>
                  <td class="py-4 px-4"><span class="text-slate-300 text-sm"><%= leave.leave_type || '-' %></span></td>
                  <td class="py-4 px-4"><span class="text-slate-400 text-sm"><%= leave.start_date ? "#{leave.start_date.strftime('%b %d')} - #{leave.end_date.strftime('%b %d, %Y')}" : '-' %></span></td>
                  <td class="py-4 px-4">
                    <span class="px-3 py-1.5 rounded-full text-xs font-medium 
                      <%= case leave.status when 'approved' then 'bg-green-500/20 text-green-400 border border-green-500/30' when 'rejected' then 'bg-red-500/20 text-red-400 border border-red-500/30' else 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30' end %>">
                      <%= leave.status || 'pending' %>
                    </span>
                  </td>
                  <td class="py-4 px-4">
                    <div class="flex gap-2 justify-end opacity-0 group-hover:opacity-100 transition-opacity">
                      <a href="<%= edit_admin_leave_request_path(leave) %>" class="p-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg></a>
                      <%= button_to '', admin_leave_request_path(leave), method: :delete, class: 'p-2 bg-red-500/10 text-red-400 rounded-lg', onclick: "confirmDelete(event, 'Leave Request')" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-16">
          <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
            <svg class="w-10 h-10 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-200 mb-2">No leave requests yet</h3>
          <a href="<%= new_admin_leave_request_path %>" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-xl font-medium">Add First Request</a>
        </div>
      <% end %>
    </div>
  </div>
</div>