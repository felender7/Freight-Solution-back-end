<header class="bg-slate-800 border-b border-slate-700 px-8 py-5">
  <h1 class="text-slate-100 text-2xl font-bold">New Attendance Record</h1>
</header>

<div class="p-8">
  <a href="<%= admin_attendance_records_path %>" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm mb-6">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back
  </a>

  <div class="bg-slate-800 rounded-xl border border-slate-700 w-full">
    <div class="p-8">
      <%= form_with model: [:admin, @attendance_record], local: true do |form| %>
        <% if @attendance_record.errors.any? %>
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
            <ul class="list-disc list-inside"><% @attendance_record.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
          </div>
        <% end %>
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Employee</label>
            <%= form.collection_select :employee_id, @employees, :id, ->(e) { "#{e.first_name} #{e.last_name}" }, { prompt: 'Select' }, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
            <%= form.select :status, options_for_select(['present', 'absent', 'late'], 'present'), {}, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Date</label>
            <%= form.date_field :date, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">IP Address</label>
            <%= form.text_field :ip_address, placeholder: '192.168.1.1', class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6 mb-8">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Clock In</label>
            <%= form.datetime_local_field :clock_in, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Clock Out</label>
            <%= form.datetime_local_field :clock_out, class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100" %>
          </div>
        </div>
        <%= form.submit 'Create Record', class: "px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium" %>
      <% end %>
    </div>
  </div>
</div>