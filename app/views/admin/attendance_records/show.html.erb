<div class="p-8 animate-fade-in space-y-8">
  
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
    <!-- Header -->
    <div class="relative px-8 py-10 bg-slate-800 border-b border-slate-700 overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-10 text-blue-500">
        <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg shadow-blue-500/20">
            <%= @attendance_record.employee.first_name[0] %>
          </div>
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-3xl font-bold text-slate-100 uppercase tracking-tight"><%= "#{@attendance_record.employee.first_name} #{@attendance_record.employee.last_name}" %></h1>
              <span class="px-3 py-1 bg-blue-500/20 text-blue-400 text-xs font-bold uppercase tracking-widest rounded-full border border-blue-500/30">
                <%= @attendance_record.status %>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-slate-400 text-sm font-medium">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Logged on <%= @attendance_record.date&.strftime('%d %b %Y') %>
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                IP: <%= @attendance_record.ip_address || 'N/A' %>
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <a href="<%= edit_admin_attendance_record_path(@attendance_record) %>" 
             class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-600/20 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Edit Record
          </a>
          <a href="<%= admin_attendance_records_path %>" 
             class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-medium transition-all flex items-center gap-2">
            Back to Registry
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x border-slate-700">
      <!-- Time Quick View -->
      <div class="p-8 bg-slate-800/30">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Session Duration</h3>
        <div class="flex items-center justify-center p-6 mb-6 rounded-3xl bg-slate-900/50 border border-slate-700">
          <div class="text-center">
            <div class="text-5xl font-black text-blue-500 mb-2">
              <%= @attendance_record.clock_out && @attendance_record.clock_in ? ((@attendance_record.clock_out - @attendance_record.clock_in) / 3600).round(1) : '0' %><span class="text-lg text-slate-600 font-normal"> hrs</span>
            </div>
            <p class="text-slate-400 text-sm font-bold uppercase tracking-tight">Working Time</p>
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/30 border border-slate-700/50">
            <span class="text-slate-300 text-sm font-medium">Clock In</span>
            <span class="text-slate-100 font-bold"><%= @attendance_record.clock_in&.strftime('%H:%M:%S') || 'N/A' %></span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/30 border border-slate-700/50">
            <span class="text-slate-300 text-sm font-medium">Clock Out</span>
            <span class="text-slate-100 font-bold"><%= @attendance_record.clock_out&.strftime('%H:%M:%S') || 'N/A' %></span>
          </div>
        </div>
      </div>

      <!-- Metadata Details -->
      <div class="p-8 lg:col-span-2">
        <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-6">Technical Log Data</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
          
          <div>
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-1 tracking-widest">Employee Position</label>
            <p class="text-xl font-bold text-slate-100"><%= @attendance_record.employee.position %></p>
            <p class="text-slate-500 text-[10px] font-bold uppercase mt-1">Dept: <%= @attendance_record.employee.department %></p>
          </div>

          <div>
            <label class="block text-slate-500 text-[10px] font-black uppercase mb-1 tracking-widest">Reporting Manager</label>
            <p class="text-xl font-bold text-indigo-400"><%= @attendance_record.employee.manager ? "#{@attendance_record.employee.manager.first_name} #{@attendance_record.employee.manager.last_name}" : 'None' %></p>
          </div>

          <div class="md:col-span-2 grid grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-slate-700/50">
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">User ID</label>
              <p class="text-slate-200 font-bold text-sm">#USR-<%= @attendance_record.user_id || 'N/A' %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">Created At</label>
              <p class="text-slate-200 font-bold text-[10px]"><%= @attendance_record.created_at.strftime('%d %b %Y') %></p>
            </div>
            <div>
              <label class="block text-slate-500 text-[10px] font-black uppercase mb-1">IP Verification</label>
              <p class="text-slate-200 font-bold text-[10px]"><%= @attendance_record.ip_address || 'None' %></p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
