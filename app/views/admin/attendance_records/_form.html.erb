<%= form_with model: [:admin, attendance_record], local: true, class: "space-y-8" do |form| %>
        
  <% if attendance_record.errors.any? %>
    <div class="p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
      <ul class="list-disc list-inside text-sm">
        <% attendance_record.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-slate-900/50 p-6 rounded-xl border border-slate-700">
    <h3 class="text-lg font-semibold text-slate-100 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Time Tracking Details
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Employee</label>
        <%= form.collection_select :employee_id, @employees, :id, ->(e) { "#{e.first_name} #{e.last_name}" }, { prompt: 'Select Employee' }, 
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
        <%= form.select :status, ['present', 'absent', 'late'], {}, 
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Clock In</label>
        <%= form.datetime_local_field :clock_in, 
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Clock Out</label>
        <%= form.datetime_local_field :clock_out, 
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">Date</label>
        <%= form.date_field :date, 
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-medium mb-2.5">IP Address</label>
        <%= form.text_field :ip_address, placeholder: 'e.g. 192.168.1.1',
            class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none" %>
      </div>
    </div>
  </div>

  <div class="pt-6 border-t border-slate-700 flex gap-4">
    <%= form.submit (attendance_record.new_record? ? 'Create Record' : 'Update Record'), 
        class: "flex-1 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25 cursor-pointer" %>
    <a href="<%= admin_attendance_records_path %>" 
       class="px-8 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-medium transition-all">
      Cancel
    </a>
  </div>

<% end %>
