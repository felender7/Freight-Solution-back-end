<div class="p-8 animate-fade-in">
  <div class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-xl max-w-4xl mx-auto">
    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between bg-slate-800/50">
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Warehouse</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Locations</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-100 uppercase tracking-tight">New Warehouse Location</h1>
        <p class="text-slate-400 text-sm mt-1 italic">Define a new storage point within the facility</p>
      </div>
      <a href="<%= admin_warehouse_locations_path %>" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg text-sm font-medium transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to List
      </a>
    </div>

    <!-- Form -->
    <div class="p-8">
      <%= render "form", location: @location %>
    </div>
  </div>
</div>
