<div class="animate-fade-in p-8">
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">
    <div class="px-8 py-6 border-b border-slate-700 flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-slate-100">Warehouse Locations</h1>
        <p class="text-slate-400 text-sm">Manage zones and storage capacity</p>
      </div>
      <a href="<%= new_admin_warehouse_location_path %>" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-bold  tracking-wider">Add Location</a>
    </div>
    <div class="p-6">
      <table class="w-full">
        <thead>
          <tr class="text-left text-slate-500 text-xs font-bold uppercase tracking-widest border-b border-slate-700/50">
            <th class="py-4 px-4">Name</th>
            <th class="py-4 px-4">Zone</th>
            <th class="py-4 px-4">Type</th>
            <th class="py-4 px-4">Utilization</th>
            <th class="py-4 px-4">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @locations.each do |loc| %>
            <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors">
              <td class="py-4 px-4 text-slate-200 font-bold"><%= loc.name %></td>
              <td class="py-4 px-4 text-slate-400"><%= loc.zone %></td>
              <td class="py-4 px-4 text-slate-400 font-mono text-xs"><%= loc.location_type %></td>
              <td class="py-4 px-4">
                <div class="w-full bg-slate-800 rounded-full h-1.5 max-w-[100px]">
                  <div class="h-full rounded-full <%= loc.utilization_percentage > 90 ? 'bg-red-500' : 'bg-blue-500' %>" style="width: <%= loc.utilization_percentage %>%"></div>
                </div>
                <span class="text-[10px] text-slate-500 mt-1 block"><%= loc.utilization_percentage %>%</span>
              </td>
              <td class="py-4 px-4">
                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase <%= loc.is_full ? 'bg-red-500/20 text-red-400' : 'bg-green-500/20 text-green-400' %>">
                  <%= loc.is_full ? 'Full' : 'Available' %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
