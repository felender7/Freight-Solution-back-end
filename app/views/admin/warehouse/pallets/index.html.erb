<div class="animate-fade-in p-8">
 <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">
  <div class="px-8 py-6 border-b border-slate-700">
   <h1 class="text-2xl font-bold text-slate-100">Pallet Tracking</h1>
   <p class="text-slate-400 text-sm">Active units in warehouse storage</p>
  </div>
  <div class="p-6">
   <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <% @pallets.each do |pallet| %>
     <div class="p-6 rounded-2xl bg-slate-900 border border-slate-700 hover:border-blue-500/50 transition-all group">
      <div class="flex justify-between items-start mb-4">
       <div class="p-3 bg-blue-500/10 rounded-xl text-blue-500 group-hover:bg-blue-600 group-hover:text-white transition-all">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
       </div>
       <span class="px-2 py-0.5 bg-slate-800 text-slate-400 text-[8px] font-black rounded"><%= pallet.status %></span>
      </div>
      <p class="text-slate-100 font-black text-lg mb-1"><%= pallet.pallet_number %></p>
      <p class="text-slate-500 text-[10px] font-bold tracking-widest mb-4"><%= pallet.client.name %></p>
      <div class="flex items-center gap-2 text-xs text-slate-400 border-t border-slate-800 pt-4">
       <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
       <%= pallet.warehouse_location&.name || 'Unassigned' %>
      </div>
     </div>
    <% end %>
   </div>
  </div>
 </div>
</div>
