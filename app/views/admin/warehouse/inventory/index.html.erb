<div class="animate-fade-in p-8">
  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">
    <div class="px-8 py-6 border-b border-slate-700 flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-slate-100">Live Inventory Records</h1>
        <p class="text-slate-400 text-sm">Real-time stock levels across all locations</p>
      </div>
      <a href="<%= new_admin_warehouse_inventory_path %>" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-bold uppercase tracking-wider">Receive Stock</a>
    </div>
    <div class="p-6">
      <table class="w-full">
        <thead>
          <tr class="text-left text-slate-500 text-xs font-bold uppercase tracking-widest border-b border-slate-700/50">
            <th class="py-4 px-4">Item (SKU)</th>
            <th class="py-4 px-4">Client</th>
            <th class="py-4 px-4">Location</th>
            <th class="py-4 px-4 text-center">Quantity</th>
            <th class="py-4 px-4">Batch / Expiry</th>
          </tr>
        </thead>
        <tbody>
          <% @inventory_records.each do |record| %>
            <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors">
              <td class="py-4 px-4">
                <p class="text-slate-200 font-bold text-sm"><%= record.inventory_item.name %></p>
                <p class="text-slate-500 text-[10px] font-mono"><%= record.inventory_item.sku %></p>
              </td>
              <td class="py-4 px-4 text-slate-300 text-sm"><%= record.client.name %></td>
              <td class="py-4 px-4 text-slate-400 text-xs font-bold uppercase"><%= record.warehouse_location.name %></td>
              <td class="py-4 px-4 text-center text-slate-100 font-black"><%= record.quantity %></td>
              <td class="py-4 px-4">
                <p class="text-slate-400 text-[10px] uppercase font-bold">B: <%= record.batch_number || 'N/A' %></p>
                <p class="text-slate-500 text-[10px]">E: <%= record.expiry_date || 'N/A' %></p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
