<div class="animate-fade-in p-8">

 <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

  <!-- Header -->
  <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
   
   <!-- Left -->
   <div>
    <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
     <span>Warehouse</span>
     <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
     </svg>
     <span>Stock Control</span>
    </div>

    <h1 class="text-3xl font-bold text-slate-100">Live Inventory</h1>
    <p class="text-slate-400 mt-1">
     Real-time stock levels, batch tracking, and storage distribution
    </p>
   </div>

   <!-- Right -->
   <a href="<%= new_admin_warehouse_inventory_path %>" 
     class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
    </svg>
    Receive Stock
   </a>
  </div>

  <!-- Notice -->
  <% if notice %>
   <div class="px-8 pt-6">
    <div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg animate-fade-in">
     <%= notice %>
    </div>
   </div>
  <% end %>

  <!-- Table -->
  <div class="p-6">
   <% if @inventory_records.any? %>
    <div class="overflow-x-auto">
     <table class="w-full">
      
      <thead>
       <tr class="border-b border-slate-700/30">
        <th class="text-left text-slate-500 text-xs font-semibold tracking-wider py-4 px-4">Product / SKU</th>
        <th class="text-left text-slate-500 text-xs font-semibold tracking-wider py-4 px-4">Client / Owner</th>
        <th class="text-left text-slate-500 text-xs font-semibold tracking-wider py-4 px-4">Storage Point</th>
        <th class="text-left text-slate-500 text-xs font-semibold tracking-wider py-4 px-4 text-center">Qty</th>
        <th class="text-right text-slate-500 text-xs font-semibold tracking-wider py-4 px-4">Actions</th>
       </tr>
      </thead>

      <tbody>
       <% @inventory_records.each do |record| %>
        <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors group">
         
         <!-- Product -->
         <td class="py-4 px-4">
          <div class="flex items-center gap-3">
           <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-indigo-400 font-bold text-xs group-hover:bg-indigo-600 group-hover:text-white transition-all">
            <%= record.inventory_item.name[0] %>
           </div>
           <div>
            <p class="text-slate-200 font-medium"><%= record.inventory_item.name %></p>
            <p class="text-slate-500 text-[10px] font-mono tracking-tighter">SKU: <%= record.inventory_item.sku %></p>
           </div>
          </div>
         </td>

         <!-- Client -->
         <td class="py-4 px-4">
          <p class="text-slate-300 text-xs font-bold "><%= record.client.name %></p>
         </td>

         <!-- Location -->
         <td class="py-4 px-4">
          <span class="px-2 py-1 rounded bg-slate-900 text-blue-400 font-mono text-[10px] font-bold border border-slate-700">
           <%= record.warehouse_location.name %>
          </span>
         </td>

         <!-- Qty -->
         <td class="py-4 px-4 text-center">
          <span class="text-slate-100 font-black text-base"><%= record.quantity %></span>
         </td>

         <!-- Actions -->
         <td class="py-4 px-4">
          <div class="flex gap-2 justify-end opacity-0 group-hover:opacity-100 transition-opacity">
           
           <a href="<%= admin_warehouse_inventory_path(record) %>" 
             class="p-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg transition-colors" title="View Detail">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
           </a>

           <a href="<%= edit_admin_warehouse_inventory_path(record) %>" 
             class="p-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg transition-colors" title="Edit/Adjust">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
           </a>

           <%= button_to admin_warehouse_inventory_path(record),
            method: :delete,
            form: { class: 'inline-block', data: { turbo: false, confirm: "Are you sure you want to remove this stock record? This action will generate an adjustment transaction." } },
            class: 'p-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors cursor-pointer',
            title: 'Delete' do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
           <% end %>

          </div>
         </td>

        </tr>
       <% end %>
      </tbody>

     </table>
    </div>

   <% else %>

    <!-- Empty State -->
    <div class="text-center py-16">
     <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center text-slate-500">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
     </div>

     <h3 class="text-xl font-semibold text-slate-200 mb-2">No inventory records</h3>
     <p class="text-slate-500 mb-6">
      Stock control is currently empty. Receive your first inbound shipment to begin.
     </p>

     <a href="<%= new_admin_warehouse_inventory_path %>" 
       class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
      </svg>
      Receive First Stock
     </a>
    </div>

   <% end %>
  </div>

 </div>
</div>
