<div class="p-8 animate-fade-in">
  <div class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-xl max-w-4xl mx-auto">
    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between bg-slate-800/50">
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Warehouse</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span>Master Data</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-100 uppercase tracking-tight">New Stock Keeping Unit (SKU)</h1>
        <p class="text-slate-400 text-sm mt-1 italic">Register a new product in the system master list</p>
      </div>
      <a href="<%= admin_warehouse_items_path %>" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg text-sm font-medium transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Master List
      </a>
    </div>

    <!-- Form -->
    <div class="p-8">
      <%= render "form", item: @item %>
    </div>
  </div>
</div>
