<div class="p-8 animate-fade-in space-y-8">
 
 <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden shadow-2xl">
  <!-- Header -->
  <div class="relative px-8 py-10 bg-slate-800 border-b border-slate-700 overflow-hidden">
   <div class="absolute top-0 right-0 p-8 opacity-10 text-indigo-500">
    <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
   </div>

   <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="flex items-center gap-6">
     <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg shadow-indigo-500/20">
      <%= @item.name[0] %>
     </div>
     <div>
      <div class="flex items-center gap-3 mb-1">
       <h1 class="text-3xl font-bold text-slate-100 tracking-tight"><%= @item.name %></h1>
       <span class="px-3 py-1 bg-indigo-500/20 text-indigo-400 text-xs font-bold tracking-widest rounded-full border border-indigo-500/30">
        <%= @item.category || 'Uncategorized' %>
       </span>
      </div>
      <div class="flex flex-wrap items-center gap-4 text-slate-400 text-sm font-mono tracking-tighter">
       <span class="flex items-center gap-1.5">
        SKU: <%= @item.sku %>
       </span>
       <span class="flex items-center gap-1.5">
        BC: <%= @item.barcode %>
       </span>
      </div>
     </div>
    </div>

    <div class="flex items-center gap-3">
     <a href="<%= edit_admin_warehouse_item_path(@item) %>" 
       class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      Edit SKU
     </a>
     <a href="<%= admin_warehouse_items_path %>" 
       class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl font-medium transition-all">
      Back to List
     </a>
    </div>
   </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x border-slate-700">
   <!-- Stock Health -->
   <div class="p-8 bg-slate-800/30">
    <h3 class="text-xs font-bold text-slate-500 tracking-widest mb-6">Inventory Status</h3>
    <div class="flex items-center justify-center p-6 mb-6 rounded-3xl bg-slate-900/50 border border-slate-700">
     <div class="text-center">
      <div class="text-5xl font-black <%= @item.total_quantity < @item.reorder_level ? 'text-red-500' : 'text-green-500' %> mb-2">
       <%= @item.total_quantity %>
      </div>
      <p class="text-slate-400 text-sm font-bold tracking-tight">Units in Stock</p>
     </div>
    </div>
    
    <div class="space-y-4">
     <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/30 border border-slate-700/50">
      <span class="text-slate-300 text-sm">Reorder Level</span>
      <span class="text-slate-100 font-bold"><%= @item.reorder_level %></span>
     </div>
     <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/30 border border-slate-700/50">
      <span class="text-slate-300 text-sm">Status</span>
      <span class="px-3 py-1 text-[10px] font-bold rounded-full 
       <%= @item.total_quantity < @item.reorder_level ? 'bg-red-500/20 text-red-400' : 'bg-green-500/20 text-green-400' %>">
       <%= @item.total_quantity < @item.reorder_level ? 'Low Stock' : 'Healthy' %>
      </span>
     </div>
    </div>
   </div>

   <!-- Core Details -->
   <div class="p-8 lg:col-span-2">
    <h3 class="text-xs font-bold text-slate-500 tracking-widest mb-6">Product Specifications</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
     
     <div>
      <label class="block text-slate-500 text-[10px] font-black mb-1 tracking-widest">Dimensions</label>
      <div class="flex items-baseline gap-2">
       <p class="text-3xl font-bold text-slate-100"><%= @item.unit_volume %></p>
       <p class="text-slate-500 font-bold text-[10px]">Cubic Meters (m³)</p>
      </div>
     </div>

     <div>
      <label class="block text-slate-500 text-[10px] font-black mb-1 tracking-widest">Weight</label>
      <div class="flex items-baseline gap-2">
       <p class="text-3xl font-bold text-slate-100"><%= @item.unit_weight %></p>
       <p class="text-slate-500 font-bold text-[10px]">Kilograms (kg)</p>
      </div>
     </div>

     <div class="md:col-span-2">
       <label class="block text-slate-500 text-[10px] font-black mb-2 tracking-widest">Product Description</label>
       <p class="text-slate-300 leading-relaxed"><%= @item.description || 'No description provided for this SKU.' %></p>
     </div>

     <div class="md:col-span-2 grid grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-slate-700/50">
      <div>
       <label class="block text-slate-500 text-[10px] font-black mb-1">Last Received</label>
       <p class="text-slate-200 font-bold text-[10px]">Today</p>
      </div>
      <div>
       <label class="block text-slate-500 text-[10px] font-black mb-1">Stock Category</label>
       <p class="text-slate-200 font-bold text-[10px]"><%= @item.category %></p>
      </div>
     </div>

    </div>
   </div>
  </div>
 </div>

 <!-- Inventory Distribution -->
 <div class="glass-card rounded-2xl border border-slate-700 bg-slate-800/50 overflow-hidden shadow-xl">
  <div class="px-8 py-6 border-b border-slate-700 flex justify-between items-center">
   <h3 class="text-lg font-bold text-slate-100 flex items-center gap-2 tracking-widest">
    <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
    Location Distribution
   </h3>
  </div>
  
  <div class="p-0">
   <% if @item.inventory_records.any? %>
    <table class="w-full">
     <thead>
      <tr class="text-left text-slate-500 text-[10px] font-black tracking-widest border-b border-slate-700/30">
       <th class="py-4 px-8">Warehouse Location</th>
       <th class="py-4 px-4 text-center">Quantity</th>
       <th class="py-4 px-4">Client / Owner</th>
       <th class="py-4 px-8 text-right">Batch</th>
      </tr>
     </thead>
     <tbody>
      <% @item.inventory_records.includes(:warehouse_location, :client).each do |record| %>
       <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors">
        <td class="py-4 px-8 font-mono text-xs text-blue-400 font-bold "><%= record.warehouse_location.name %></td>
        <td class="py-4 px-4 text-center font-black text-slate-100"><%= record.quantity %></td>
        <td class="py-4 px-4 text-slate-400 text-xs font-bold "><%= record.client.name %></td>
        <td class="py-4 px-8 text-right text-slate-500 font-mono text-[10px]"><%= record.batch_number %></td>
       </tr>
      <% end %>
     </tbody>
    </table>
   <% else %>
    <div class="py-12 text-center text-slate-500 italic text-sm">No live stock found for this SKU in any location.</div>
   <% end %>
  </div>
 </div>
</div>
