<div class="animate-fade-in p-8">

  <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      
      <!-- Left -->
      <div>
        <div class="flex items-center gap-2 text-slate-500 text-sm mb-1">
          <span>Dashboard</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span>Warehouse</span>
        </div>

        <h1 class="text-3xl font-bold text-slate-100">Warehouse Dashboard</h1>
        <p class="text-slate-400 mt-1">
          Real-time space optimization and automated storage tracking
        </p>
      </div>

      <!-- Right -->
      <div class="flex items-center gap-3">
        <a href="<%= new_admin_warehouse_inventory_path %>" 
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          Receive Stock
        </a>
      </div>
    </div>

    <!-- Notice -->
    <% if notice %>
      <div class="px-8 pt-6">
        <div class="p-4 bg-green-500/10 border border-green-500/30 text-green-400 rounded-lg animate-fade-in">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <!-- Capacity Dashboard Content -->
    <div class="p-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Utilization Gauge -->
        <div class="glass-card rounded-2xl p-8 border border-slate-700/50 flex flex-col items-center justify-center relative overflow-hidden bg-slate-800/30">
          <div class="absolute top-0 right-0 p-4 opacity-5">
            <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          
          <h3 class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-6">Warehouse Utilization</h3>
          
          <div class="relative w-48 h-48 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90">
              <circle cx="96" cy="96" r="80" stroke="currentColor" stroke-width="12" fill="transparent" class="text-slate-800" />
              <circle cx="96" cy="96" r="80" stroke="currentColor" stroke-width="12" fill="transparent" 
                      stroke-dasharray="<%= 2 * Math::PI * 80 %>" 
                      stroke-dashoffset="<%= (1 - @utilization / 100.0) * 2 * Math::PI * 80 %>" 
                      class="<%= @utilization > 85 ? 'text-red-500' : (@utilization > 60 ? 'text-yellow-500' : 'text-blue-500') %> transition-all duration-1000 ease-out" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-4xl font-black text-slate-100"><%= @utilization %>%</span>
              <span class="text-[10px] font-bold text-slate-500 uppercase">Capacity Used</span>
            </div>
          </div>
          
          <div class="mt-8 grid grid-cols-2 gap-8 w-full border-t border-slate-700/50 pt-6">
            <div class="text-center">
              <p class="text-slate-500 text-[10px] font-bold uppercase mb-1">Used Volume</p>
              <p class="text-slate-100 font-bold"><%= number_with_delimiter(@current_vol.round(2)) %> m³</p>
            </div>
            <div class="text-center">
              <p class="text-slate-500 text-[10px] font-bold uppercase mb-1">Total Capacity</p>
              <p class="text-slate-100 font-bold"><%= number_with_delimiter(@total_capacity_vol.round(2)) %> m³</p>
            </div>
          </div>
        </div>

        <!-- AI Space Optimization -->
        <div class="glass-card rounded-2xl p-8 border border-slate-700/50 bg-gradient-to-br from-slate-800 to-indigo-900/20">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 bg-indigo-500/20 rounded-lg">
              <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-slate-100 font-bold">AI Space Optimization</h3>
          </div>
          
          <div class="space-y-6">
            <div class="p-4 bg-slate-900/60 rounded-xl border border-indigo-500/30">
              <p class="text-indigo-300 text-xs font-bold uppercase mb-2">Optimization Engines</p>
              <div class="flex flex-col gap-3">
                <div class="flex items-center justify-between">
                  <span class="text-slate-400 text-sm">Smart Path Picking</span>
                  <span class="px-2 py-0.5 bg-green-500/20 text-green-400 text-[8px] font-black uppercase rounded border border-green-500/30">Active</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-400 text-sm">Automated Billing</span>
                  <span class="px-2 py-0.5 bg-green-500/20 text-green-400 text-[8px] font-black uppercase rounded border border-green-500/30">Enabled</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-400 text-sm">Volume Prediction</span>
                  <span class="px-2 py-0.5 bg-blue-500/20 text-blue-400 text-[8px] font-black uppercase rounded border border-blue-500/30">Learning</span>
                </div>
              </div>
            </div>
            
            <div class="space-y-3">
              <p class="text-slate-400 text-sm italic">"WMS suggested 4 storage reorganizations today to improve picking speed by 12%."</p>
              <button class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold uppercase tracking-widest transition-all">Run Space Audit</button>
            </div>
          </div>
        </div>

        <!-- Stock Health -->
        <div class="glass-card rounded-2xl p-8 border border-slate-700/50 bg-slate-800/30">
          <h3 class="text-slate-100 font-bold mb-6">Stock Health & Reporting</h3>
          <div class="space-y-4">
            <% if @low_stock_items.any? %>
              <% @low_stock_items.each do |item| %>
                <div class="flex items-center justify-between p-3 bg-red-500/10 border border-red-500/20 rounded-xl">
                  <div>
                    <p class="text-slate-200 text-sm font-bold"><%= item.name %></p>
                    <p class="text-red-400 text-[10px] uppercase font-black">Stock Level: <%= item.total_qty %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-slate-500 text-[10px] uppercase font-bold">Reorder at</p>
                    <p class="text-slate-300 text-xs font-bold"><%= item.reorder_level %></p>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="py-12 text-center">
                <svg class="w-12 h-12 text-slate-700 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-slate-500 text-sm">All inventory levels healthy</p>
              </div>
            <% end %>
            <button class="w-full py-3 border border-slate-600 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-bold uppercase tracking-widest transition-all mt-4">Export Stock Report</button>
          </div>
        </div>
      </div>

      <!-- Navigation Module Cards -->
      <h2 class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-6 px-2">Operational Modules</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <!-- Stock Control Card -->
        <a href="<%= admin_warehouse_inventory_index_path %>" class="group relative p-8 rounded-3xl bg-slate-800/40 border border-slate-700 hover:border-blue-500/50 transition-all duration-300 overflow-hidden">
          <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
            <svg class="w-32 h-32 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500 mb-6 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-100 mb-2">Stock Control</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-6">Manage live inventory, batch tracking, and real-time movements.</p>
          <span class="inline-flex items-center gap-2 text-blue-400 text-xs font-bold uppercase tracking-widest group-hover:gap-3 transition-all">
            Access Module
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </span>
        </a>

        <!-- Master Data Card -->
        <a href="<%= admin_warehouse_items_path %>" class="group relative p-8 rounded-3xl bg-slate-800/40 border border-slate-700 hover:border-indigo-500/50 transition-all duration-300 overflow-hidden">
          <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
            <svg class="w-32 h-32 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-indigo-500 mb-6 group-hover:bg-indigo-500 group-hover:text-white transition-all duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-100 mb-2">Master Data</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-6">Configure SKU attributes, product categories, and dimension rules.</p>
          <span class="inline-flex items-center gap-2 text-indigo-400 text-xs font-bold uppercase tracking-widest group-hover:gap-3 transition-all">
            Manage Registry
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </span>
        </a>

        <!-- Locations Card -->
        <a href="<%= admin_warehouse_locations_path %>" class="group relative p-8 rounded-3xl bg-slate-800/40 border border-slate-700 hover:border-purple-500/50 transition-all duration-300 overflow-hidden">
          <div class="absolute -right-4 -bottom-4 opacity-5 group-hover:opacity-10 transition-opacity">
            <svg class="w-32 h-32 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div class="w-14 h-14 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-500 mb-6 group-hover:bg-purple-500 group-hover:text-white transition-all duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-100 mb-2">Space Settings</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-6">Define storage zones, rack systems, and capacity limits.</p>
          <span class="inline-flex items-center gap-2 text-purple-400 text-xs font-bold uppercase tracking-widest group-hover:gap-3 transition-all">
            Adjust Layout
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </span>
        </a>
      </div>

      <!-- Recent Warehouse Activity -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full">
        <!-- Transactions -->
        <div class="glass-card rounded-2xl border border-slate-700/50 overflow-hidden bg-slate-800/30">
          <div class="px-6 py-4 border-b border-slate-700/50 flex justify-between items-center">
            <h2 class="text-slate-100 font-bold uppercase text-sm tracking-widest">Live Activity Log</h2>
            <span class="px-2 py-0.5 bg-green-500/20 text-green-400 text-[8px] font-black uppercase rounded border border-green-500/30">Real-time</span>
          </div>
          <div class="p-0">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-slate-900/50 border-b border-slate-700/30 text-left">
                    <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase">Action</th>
                    <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase">SKU / Item</th>
                    <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase text-center">Qty</th>
                    <th class="px-6 py-3 text-right text-[10px] font-bold text-slate-500 uppercase">Time</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/30">
                  <% if @recent_transactions.any? %>
                    <% @recent_transactions.each do |tx| %>
                      <tr class="hover:bg-slate-700/20 transition-colors">
                        <td class="px-6 py-4">
                          <span class="px-2 py-1 rounded text-[8px] font-black uppercase
                            <%= case tx.transaction_type
                              when 'receiving' then 'bg-blue-500/20 text-blue-400'
                              when 'picking' then 'bg-yellow-500/20 text-yellow-400'
                              else 'bg-slate-700 text-slate-400'
                            end %>">
                            <%= tx.transaction_type %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-xs font-bold text-slate-300">
                          <%= tx.inventory_item.sku %>
                        </td>
                        <td class="px-6 py-4 text-xs font-black text-slate-100 text-center">
                          <%= tx.quantity %>
                        </td>
                        <td class="px-6 py-4 text-right text-[10px] text-slate-500">
                          <%= tx.created_at.strftime('%H:%M') %>
                        </td>
                      </tr>
                    <% end %>
                  <% else %>
                    <tr><td colspan="4" class="py-12 text-center text-slate-600 text-sm">No activity recorded today</td></tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Inventory Snapshots -->
        <div class="glass-card rounded-2xl border border-slate-700/50 overflow-hidden bg-slate-800/30">
          <div class="px-6 py-4 border-b border-slate-700/50">
            <h2 class="text-slate-100 font-bold uppercase text-sm tracking-widest">System Barcodes</h2>
          </div>
          <div class="p-6 grid grid-cols-2 md:grid-cols-3 gap-4">
            <% @inventory_summary.each do |item| %>
              <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700 hover:border-blue-500 transition-all group cursor-pointer">
                <div class="w-full h-8 bg-white/5 rounded mb-3 flex items-center justify-center group-hover:bg-blue-500/10 transition-all">
                  <div class="w-3/4 h-4 bg-slate-400 opacity-20 flex gap-0.5">
                    <% 12.times do %><div class="h-full bg-slate-100" style="width: <%= [1,2,3].sample %>px"></div><% end %>
                  </div>
                </div>
                <p class="text-[10px] font-black text-slate-300 uppercase truncate w-full text-center"><%= item.name %></p>
                <p class="text-[8px] text-slate-500 font-mono text-center"><%= item.sku %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
