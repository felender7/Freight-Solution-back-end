<div class="animate-fade-in p-8">
 <div class="glass-card rounded-2xl border border-slate-700 overflow-hidden w-full">
  <div class="px-8 py-6 border-b border-slate-700">
   <h1 class="text-2xl font-bold text-slate-100 tracking-tight">Automated Storage Billing</h1>
   <p class="text-slate-400 text-sm">Daily rate auto-calculations per client</p>
  </div>
  <div class="p-6">
   <table class="w-full">
    <thead>
     <tr class="text-left text-slate-500 text-xs font-bold tracking-widest border-b border-slate-700/50">
      <th class="py-4 px-4">Billing Date</th>
      <th class="py-4 px-4">Client</th>
      <th class="py-4 px-4 text-center">Active Pallets</th>
      <th class="py-4 px-4 text-center">Daily Rate</th>
      <th class="py-4 px-4 text-right">Total Amount</th>
     </tr>
    </thead>
    <tbody>
     <% @billings.each do |bill| %>
      <tr class="border-b border-slate-700/30 hover:bg-slate-700/20 transition-colors">
       <td class="py-4 px-4 text-slate-300 font-bold"><%= bill.billing_date.strftime('%d %b %Y') %></td>
       <td class="py-4 px-4 text-slate-100 font-bold"><%= bill.client.name %></td>
       <td class="py-4 px-4 text-center text-slate-400 font-black"><%= bill.total_pallets %></td>
       <td class="py-4 px-4 text-center text-slate-500 text-xs">R<%= number_with_precision(bill.daily_rate, precision: 2) %> / day</td>
       <td class="py-4 px-4 text-right">
        <span class="text-slate-100 font-black">R<%= number_with_precision(bill.amount, precision: 2) %></span>
        <span class="block text-[8px] font-black <%= bill.status == 'paid' ? 'text-green-500' : 'text-yellow-500' %>"><%= bill.status %></span>
       </td>
      </tr>
     <% end %>
    </tbody>
   </table>
  </div>
 </div>
</div>
