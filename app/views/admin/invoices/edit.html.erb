<div class="p-8">

  <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden w-full">

    <!-- Header -->
    <div class="px-8 py-6 border-b border-slate-700 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-100">Edit Invoice</h1>
        <p class="text-slate-400 text-sm mt-1">
          Update invoice details, amounts, and payment status
        </p>
      </div>

      <a href="<%= admin_invoices_path %>" 
         class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
      </a>
    </div>

    <!-- Form -->
    <div class="p-8">
      <%= form_with model: [:admin, @invoice], local: true do |f| %>

        <% if @invoice.errors.any? %>
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 text-red-400 rounded-lg">
            <ul class="list-disc list-inside">
              <% @invoice.errors.full_messages.each do |m| %>
                <li><%= m %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Invoice + Vendor -->
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Invoice Number</label>
            <%= f.text_field :invoice_number, required: true,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>

          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Vendor</label>
            <%= f.collection_select :vendor_id, @vendors, :id, :name,
              { include_blank: true },
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>
        </div>

        <!-- Amount + Status -->
        <div class="grid grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Amount</label>
            <%= f.number_field :amount, step: '0.01',
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>

          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Status</label>
            <%= f.select :status, ['pending', 'paid', 'overdue'], {},
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>
        </div>

        <!-- Dates -->
        <div class="grid grid-cols-2 gap-6 mb-8">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Due Date</label>
            <%= f.date_field :due_date,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>

          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2.5">Paid Date</label>
            <%= f.date_field :paid_date,
              class: "w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all" %>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4">
          <%= f.submit 'Update Invoice',
            class: "px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-medium transition-all cursor-pointer" %>

          <a href="<%= admin_invoices_path %>" 
             class="px-6 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg font-medium transition-all">
            Cancel
          </a>
        </div>

      <% end %>
    </div>

  </div>
</div>