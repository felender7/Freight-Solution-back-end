<header class="main-header"><h1 class="page-title">New Invoice</h1></header>
<div class="main-body">
  <a href="<%= admin_invoices_path %>" class="back-link"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>Back</a>
  <div class="card" style="margin-top: 24px;"><div class="card-body">
    <%= form_with model: [:admin, @invoice], local: true do |f| %>
      <div class="form-row"><div class="form-group-full"><%= f.label :invoice_number %><%= f.text_field :invoice_number, required: true %></div><div class="form-group-full"><%= f.label :vendor_id %><%= f.collection_select :vendor_id, @vendors, :id, :name, include_blank: true %></div></div>
      <div class="form-row"><div class="form-group-full"><%= f.label :amount %><%= f.number_field :amount, step: '0.01' %></div><div class="form-group-full"><%= f.label :status %><%= f.select :status, ['pending', 'paid', 'overdue'], selected: 'pending' %></div></div>
      <div class="form-row"><div class="form-group-full"><%= f.label :due_date %><%= f.date_field :due_date %></div><div class="form-group-full"><%= f.label :paid_date %><%= f.date_field :paid_date %></div></div>
      <div style="margin-top: 24px;"><%= f.submit 'Create', class: 'btn btn-blue' %></div>
    <% end %>
  </div></div>
</div>