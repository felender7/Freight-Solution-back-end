<div id="<%= dom_id employee %>">
  <div>
    <strong>First name:</strong>
    <%= employee.first_name %>
  </div>

  <div>
    <strong>Last name:</strong>
    <%= employee.last_name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= employee.email %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= employee.phone %>
  </div>

  <div>
    <strong>Position:</strong>
    <%= employee.position %>
  </div>

  <div>
    <strong>Department:</strong>
    <%= employee.department %>
  </div>

  <div>
    <strong>Salary:</strong>
    <%= employee.salary %>
  </div>

  <div>
    <strong>Hire date:</strong>
    <%= employee.hire_date %>
  </div>

</div>
