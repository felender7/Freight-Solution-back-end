<%= form_with(model: shipment) do |form| %>
  <% if shipment.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(shipment.errors.count, "error") %> prohibited this shipment from being saved:</h2>

      <ul>
        <% shipment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :container_number, style: "display: block" %>
    <%= form.text_field :container_number %>
  </div>

  <div>
    <%= form.label :booking_reference, style: "display: block" %>
    <%= form.text_field :booking_reference %>
  </div>

  <div>
    <%= form.label :origin, style: "display: block" %>
    <%= form.text_field :origin %>
  </div>

  <div>
    <%= form.label :destination, style: "display: block" %>
    <%= form.text_field :destination %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.label :ship_date, style: "display: block" %>
    <%= form.date_field :ship_date %>
  </div>

  <div>
    <%= form.label :estimated_arrival, style: "display: block" %>
    <%= form.date_field :estimated_arrival %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
