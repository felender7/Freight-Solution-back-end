<p style="color: green"><%= notice %></p>

<%= render @shipment %>

<div class="mt-6 flex gap-4">
  <%= link_to "Edit this shipment", edit_shipment_path(@shipment), class: "px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg" %>
  <%= link_to "Back to shipments", shipments_path, class: "px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-300 rounded-lg" %>
  
  <%= link_to @shipment, 
      method: :delete, 
      data: { turbo: false, confirm: "Are you sure you want to delete this shipment?" },
      class: "px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
    </svg>
    Delete
  <% end %>
</div>
